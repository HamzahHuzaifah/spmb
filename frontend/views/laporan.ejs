<%- include('partials/header', { title: 'Laporan Utama' , activePage: 'laporan' }) %>

    <div class="premium-banner premium-banner-purple" style="margin-top: 20px;">
        <div>
            <h1>Laporan Keuangan Global</h1>
            <p>Rekapitulasi seluruh transaksi secara terperinci per bulan</p>
        </div>
        <div class="premium-banner-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
    </div>

<div class="filter-bar">
        <form method="GET" action="/laporan" class="filter-form">
            <input type="text" name="search" class="form-control filter-search" placeholder="Cari Uraian / No Trans..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <input type="number" class="form-control filter-input-tahun" name="tahun" id="filterTahun" placeholder="Tahun" min="2000" max="2100" value="<%= typeof tahunQuery !== 'undefined' ? tahunQuery : '' %>">
            <select class="form-control filter-select-bulan" name="bulan" id="filterBulan">
                <option value="">Semua Bulan</option>
                <option value="01" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '01') ? 'selected' : '' %>>Januari</option>
                <option value="02" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '02') ? 'selected' : '' %>>Februari</option>
                <option value="03" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '03') ? 'selected' : '' %>>Maret</option>
                <option value="04" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '04') ? 'selected' : '' %>>April</option>
                <option value="05" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '05') ? 'selected' : '' %>>Mei</option>
                <option value="06" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '06') ? 'selected' : '' %>>Juni</option>
                <option value="07" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '07') ? 'selected' : '' %>>Juli</option>
                <option value="08" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '08') ? 'selected' : '' %>>Agustus</option>
                <option value="09" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '09') ? 'selected' : '' %>>September</option>
                <option value="10" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '10') ? 'selected' : '' %>>Oktober</option>
                <option value="11" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '11') ? 'selected' : '' %>>November</option>
                <option value="12" <%= (typeof bulanQuery !== 'undefined' && bulanQuery === '12') ? 'selected' : '' %>>Desember</option>
            </select>
            <button class="btn btn-primary btn-submit-filter" type="submit">Filter</button>
            <a href="/laporan" class="btn btn-secondary btn-reset-filter">Reset</a>
        </form>

        <div class="filter-actions">
            <button type="button" class="btn btn-info btn-preview-laporan" onclick="openModalLaporan()">
                <i class="fas fa-eye"></i> Preview Laporan
            </button>
            <a href="/laporan/export-excel?search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>&bulan=<%= typeof bulanQuery !== 'undefined' ? bulanQuery : '' %>&tahun=<%= typeof tahunQuery !== 'undefined' ? tahunQuery : '' %>" class="btn btn-secondary btn-print-laporan btn-print" style="text-decoration: none;" download>
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
        </div>
    </div>

    <!-- Tab Buttons -->
    <div class="tabs-container tabs-container-laporan">
        <button class="tab-btn tab-btn-laporan active" onclick="switchTab('spmb-tab')" id="btn-spmb-tab">
            <i class="fas fa-university"></i> Laporan Internal SPMB
        </button>
        <button class="tab-btn tab-btn-laporan" onclick="switchTab('sikma-tab')" id="btn-sikma-tab">
            <i class="fas fa-exchange-alt"></i> Laporan via SIKMA
        </button>
    </div>



    <%
    function formatDateIndo(dateStr) {
        if(!dateStr) return '';
        let d = new Date(dateStr);
        if(isNaN(d)) return dateStr;
        let dd = String(d.getDate()).padStart(2, '0');
        let mm = String(d.getMonth() + 1).padStart(2, '0');
        let yyyy = d.getFullYear();
        return `${dd}/${mm}/${yyyy}`;
    }
    const monthsList = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
    %>

    <!-- Tab 1 Contents: SPMB Internal -->
    <div id="spmb-tab-content" class="premium-table-container" style="display: block; margin-top: 20px;">
        <div class="table-header" style="margin-bottom: 20px; padding: 0 10px;">
            <div class="table-title" style="font-weight: 700; font-size: 18px; color: #1e293b;"><i class="fas fa-table mr-2"></i> Laporan Keuangan SPMB JIC (Internal)</div>
        </div>

        <div class="table-responsive" style="overflow-x: auto; width: 100%;">
            <table id="tabelLaporan" class="premium-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Tanggal</th>
                        <th>Bulan</th>
                        <th>No Transaksi</th>
                        <th>Uraian</th>
                        <th>Pemasukan</th>
                        <th>Pengeluaran</th>
                        <th>Saldo Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                    let saldoSpmb = typeof saldoAwalQuerySpmb !== 'undefined' ? Number(saldoAwalQuerySpmb) : 0; 
                    if (isNaN(saldoSpmb)) saldoSpmb = 0;
                    let noSpmb = 1;
                    %>
                    
                    <% if (typeof bulanQuery !== 'undefined' && bulanQuery !== '') { 
                        let selBulanIdx = monthsList.indexOf(bulanQuery);
                        if (selBulanIdx === -1) selBulanIdx = parseInt(bulanQuery) - 1;
                        if (isNaN(selBulanIdx) || selBulanIdx < 0 || selBulanIdx > 11) selBulanIdx = new Date().getMonth();
                        
                        let selTahun = typeof tahunQuery !== 'undefined' && tahunQuery ? parseInt(tahunQuery) : new Date().getFullYear();
                        let prevMonthName = selBulanIdx === 0 ? "Desember" : monthsList[selBulanIdx - 1];
                        let prevMonthYear = selBulanIdx === 0 ? selTahun - 1 : selTahun;
                    %>
                    <tr>
                        <td><%= noSpmb++ %></td>
                        <td>01/<%= String(selBulanIdx + 1).padStart(2, '0') %>/<%= selTahun %></td>
                        <td><%= monthsList[selBulanIdx] %> <%= selTahun %></td>
                        <td>-</td>
                        <td>Saldo Bulan <%= prevMonthName %> <%= prevMonthYear %></td>
                        <td style="color: var(--success);"><%= saldoSpmb > 0 ? 'Rp ' + Number(saldoSpmb).toLocaleString('id-ID') : (saldoSpmb === 0 ? 'Rp 0' : '-') %></td>
                        <td style="color: var(--danger);"><%= saldoSpmb < 0 ? 'Rp ' + Math.abs(Number(saldoSpmb)).toLocaleString('id-ID') : '-' %></td>
                        <td style="font-weight: bold;">Rp <%= Number(saldoSpmb).toLocaleString('id-ID') %></td>
                    </tr>
                    <% } %>

                    <% if(laporanSpmb && laporanSpmb.length > 0) {
                        laporanSpmb.forEach((item) => {
                        saldoSpmb = Number(saldoSpmb) + (Number(item.pemasukan) || 0) - (Number(item.pengeluaran) || 0);
                        %>
                        <tr>
                            <td><%= noSpmb++ %></td>
                            <td><%= formatDateIndo(item.tanggal) %></td>
                            <td>
                                <% 
                                const bulanIdx = parseInt(item.bulan) - 1;
                                const namaBulan = (bulanIdx >= 0 && bulanIdx < 12) ? monthsList[bulanIdx] : item.bulan;
                                %>
                                <%= namaBulan %> <%= item.tahun %>
                            </td>
                            <td><%= item.noTransaksi %></td>
                            <td><%= item.uraian %></td>
                            <td style="color: var(--success);">
                                <%= Number(item.pemasukan) > 0 ? 'Rp ' + Number(item.pemasukan).toLocaleString('id-ID') : '-' %>
                            </td>
                            <td style="color: var(--danger);">
                                <%= Number(item.pengeluaran) > 0 ? 'Rp ' + Number(item.pengeluaran).toLocaleString('id-ID') : '-' %>
                            </td>
                            <td style="font-weight: bold;">Rp <%= Number(saldoSpmb).toLocaleString('id-ID') %></td>
                        </tr>
                    <% }) } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center;">Tidak ada data laporan</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab 2 Contents: SIKMA Integration -->
    <div id="sikma-tab-content" class="premium-table-container" style="display: none; margin-top: 20px;">
        <div class="table-header" style="margin-bottom: 20px; padding: 0 10px;">
            <div class="table-title" style="font-weight: 700; font-size: 18px; color: #1e293b;"><i class="fas fa-table mr-2"></i> Laporan Keuangan SPMB JIC (Input via SIKMA)</div>
        </div>

        <div class="table-responsive" style="overflow-x: auto; width: 100%;">
            <table id="tabelLaporanSikma" class="premium-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Tanggal</th>
                        <th>Bulan</th>
                        <th>No Transaksi</th>
                        <th>Uraian</th>
                        <th>Pemasukan</th>
                        <th>Pengeluaran</th>
                        <th>Saldo Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                    let saldoSikma = typeof saldoAwalQuerySikma !== 'undefined' ? Number(saldoAwalQuerySikma) : 0; 
                    if (isNaN(saldoSikma)) saldoSikma = 0;
                    let noSikma = 1;
                    %>
                    
                    <% if (typeof bulanQuery !== 'undefined' && bulanQuery !== '') { 
                        let selBulanIdx = monthsList.indexOf(bulanQuery);
                        if (selBulanIdx === -1) selBulanIdx = parseInt(bulanQuery) - 1;
                        if (isNaN(selBulanIdx) || selBulanIdx < 0 || selBulanIdx > 11) selBulanIdx = new Date().getMonth();
                        
                        let selTahun = typeof tahunQuery !== 'undefined' && tahunQuery ? parseInt(tahunQuery) : new Date().getFullYear();
                        let prevMonthName = selBulanIdx === 0 ? "Desember" : monthsList[selBulanIdx - 1];
                        let prevMonthYear = selBulanIdx === 0 ? selTahun - 1 : selTahun;
                    %>
                    <tr>
                        <td><%= noSikma++ %></td>
                        <td>01/<%= String(selBulanIdx + 1).padStart(2, '0') %>/<%= selTahun %></td>
                        <td><%= monthsList[selBulanIdx] %> <%= selTahun %></td>
                        <td>-</td>
                        <td>Saldo Bulan <%= prevMonthName %> <%= prevMonthYear %></td>
                        <td style="color: var(--success);"><%= saldoSikma > 0 ? 'Rp ' + Number(saldoSikma).toLocaleString('id-ID') : (saldoSikma === 0 ? 'Rp 0' : '-') %></td>
                        <td style="color: var(--danger);"><%= saldoSikma < 0 ? 'Rp ' + Math.abs(Number(saldoSikma)).toLocaleString('id-ID') : '-' %></td>
                        <td style="font-weight: bold;">Rp <%= Number(saldoSikma).toLocaleString('id-ID') %></td>
                    </tr>
                    <% } %>

                    <% if(laporanSikma && laporanSikma.length > 0) {
                        laporanSikma.forEach((item) => {
                        saldoSikma = Number(saldoSikma) + (Number(item.pemasukan) || 0) - (Number(item.pengeluaran) || 0);
                        %>
                        <tr>
                            <td><%= noSikma++ %></td>
                            <td><%= formatDateIndo(item.tanggal) %></td>
                            <td>
                                <% 
                                const bulanIdx = parseInt(item.bulan) - 1;
                                const namaBulan = (bulanIdx >= 0 && bulanIdx < 12) ? monthsList[bulanIdx] : item.bulan;
                                %>
                                <%= namaBulan %> <%= item.tahun %>
                            </td>
                            <td><%= item.noTransaksi %></td>
                            <td><%= item.uraian %></td>
                            <td style="color: var(--success);">
                                <%= Number(item.pemasukan) > 0 ? 'Rp ' + Number(item.pemasukan).toLocaleString('id-ID') : '-' %>
                            </td>
                            <td style="color: var(--danger);">
                                <%= Number(item.pengeluaran) > 0 ? 'Rp ' + Number(item.pengeluaran).toLocaleString('id-ID') : '-' %>
                            </td>
                            <td style="font-weight: bold;">Rp <%= Number(saldoSikma).toLocaleString('id-ID') %></td>
                        </tr>
                    <% }) } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center;">Tidak ada data laporan</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <!-- Laporan Modal (Iframe) -->
    <div id="laporanModal" class="modal-overlay modal-overlay-laporan">
        <div class="modal-content modal-content-laporan">
            <div class="modal-header-laporan">
                <h3 class="modal-title-laporan">Preview Laporan</h3>
                <span class="close-modal modal-close-laporan" onclick="closeModalLaporan()">&times;</span>
            </div>
            <div class="modal-body-laporan">
                <iframe id="laporanIframe" src="" class="modal-iframe-laporan"></iframe>
            </div>
        </div>
    </div>

    <script src="/js/laporan.js"></script>

    <%- include('partials/footer') %>