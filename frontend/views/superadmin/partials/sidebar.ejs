<div class="sidebar">
    <div class="sidebar-header">
        <div class="logo">MJIC</div>
        <h2>Keuangan SPMB JIC</h2>
    </div>
    <div class="sidebar-menu">
        <%
          const menuSections = [
            {
              title: 'Super Admin',
              items: [
                { href: '/superadmin/dashboard', page: 'dashboard', icon: 'fas fa-home', text: 'Dashboard Utama' },
                { href: '/superadmin/users', page: 'users', icon: 'fas fa-users-cog', text: 'Manajemen Pengguna' },
                { href: '/superadmin/master-data', page: 'master-data', icon: 'fas fa-database', text: 'Master Data & Jadwal' },
                { href: '/superadmin/logs', page: 'logs', icon: 'fas fa-history', text: 'Log Aktivitas' }
              ]
            },
            {
              title: 'Kembali Ke Admin',
              items: [
                { href: '/dashboard', page: 'admin-dashboard', icon: 'fas fa-arrow-left', text: 'Dashboard Admin Biasa' }
              ]
            }
          ];
        %>

        <% menuSections.forEach(section => { %>
            <% if (section.title) { %>
                <div style="padding: 15px 24px 5px; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1px;"><%= section.title %></div>
            <% } %>
            <% section.items.forEach(item => { %>
                <a href="<%= item.href %>" class="menu-item <%= (typeof activePage !== 'undefined' && activePage === item.page) ? 'active' : '' %>">
                    <i class="<%= item.icon %>"></i> <%= item.text %>
                </a>
            <% }) %>
        <% }) %>

        <div style="padding: 15px 24px 5px; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1px;">Integrasi</div>
        <a href="/sso/go-sikma" target="_blank" class="menu-item" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
            <i class="fas fa-external-link-alt"></i> Buka Web SIKMA
        </a>

        <!-- Tombol Logout -->
        <div style="margin-top: 30px; padding: 0 24px 24px;">
            <a href="/logout" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; background-color: rgba(239, 68, 68, 0.2); color: #fca5a5; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: var(--transition);" onmouseover="this.style.backgroundColor='rgba(239, 68, 68, 0.4)'; this.style.color='white';" onmouseout="this.style.backgroundColor='rgba(239, 68, 68, 0.2)'; this.style.color='#fca5a5';">
                <i class="fas fa-sign-out-alt"></i> Logout Keluar
            </a>
        </div>
    </div>
</div>

