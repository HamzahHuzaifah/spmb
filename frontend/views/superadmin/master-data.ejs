<%- include('partials/header', { title: 'Master Data & Jadwal', activePage: 'master-data' }) %>

<div class="content-area">
    <div style="background: linear-gradient(135deg, #064e3b 0%, #10b981 100%); border-radius: var(--radius-md); padding: 30px 40px; margin-bottom: 30px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.25);">
        <div>
            <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 8px 0; letter-spacing: -0.5px;">Master Data & Konfigurasi</h1>
            <p style="color: rgba(255,255,255,0.85); margin: 0; font-size: 15px;">Atur jenjang, gelombang pendaftaran, dan jalur masuk secara dinamis</p>
        </div>
        <div style="background: rgba(255,255,255,0.1); width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px);">
            <i class="fas fa-database" style="font-size: 28px; color: white;"></i>
        </div>
    </div>

    <!-- Custom Tabs Navigation -->
    <div style="display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px;">
        <button class="nav-tab active-tab" onclick="switchTab('jenjang')" id="tab-btn-jenjang" style="padding: 12px 24px; border: none; background: #e0f2fe; color: #0ea5e9; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s;">
            <i class="fas fa-graduation-cap" style="margin-right: 8px;"></i> Data Jenjang
        </button>
        <button class="nav-tab" onclick="switchTab('gelombang')" id="tab-btn-gelombang" style="padding: 12px 24px; border: none; background: transparent; color: #64748b; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s;">
            <i class="fas fa-calendar-alt" style="margin-right: 8px;"></i> Gelombang Pendaftaran
        </button>
        <button class="nav-tab" onclick="switchTab('jalur')" id="tab-btn-jalur" style="padding: 12px 24px; border: none; background: transparent; color: #64748b; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s;">
            <i class="fas fa-route" style="margin-right: 8px;"></i> Jalur Pendaftaran
        </button>
    </div>

    <!-- JENJANG -->
    <div id="tab-jenjang" class="tab-content-section" style="display: block;">
        <div class="table-container" style="border-radius: var(--radius-md); border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
            <div class="table-header">
                <h5 class="table-title" style="margin: 0; color: #1e293b; font-weight: 700;">Daftar Jenjang Akademik</h5>
                <button class="btn btn-primary" onclick="openModal('jenjang')" style="background: #10b981; border-radius: 8px; padding: 10px 20px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                    <i class="fas fa-plus"></i> Tambah Jenjang
                </button>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">No</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Nama Jenjang</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Kuota</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Status</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; text-align: right;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jenjang.forEach((j, idx) => { %>
                        <tr style="transition: all 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><%= idx + 1 %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; font-weight: 500; color: #1e293b;"><%= j.nama %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><%= j.kuota %> Santri</td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9;">
                                <% if(j.status === 'Aktif') { %>
                                    <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Aktif</span>
                                <% } else { %>
                                    <span style="background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Nonaktif</span>
                                <% } %>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: right;">
                                <button data-item="<%= JSON.stringify(j) %>" onclick="openModal('jenjang', true, JSON.parse(this.getAttribute('data-item')))" class="btn-edit" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 5px;"><i class="fas fa-edit"></i> Edit</button>
                                <button onclick="deleteData('jenjang', <%= j.id %>)" class="btn-delete" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;"><i class="fas fa-trash"></i> Hapus</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- GELOMBANG -->
    <div id="tab-gelombang" class="tab-content-section" style="display: none;">
        <div class="table-container" style="border-radius: var(--radius-md); border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
            <div class="table-header">
                <h5 class="table-title" style="margin: 0; color: #1e293b; font-weight: 700;">Jadwal Gelombang Pendaftaran</h5>
                <button class="btn btn-primary" onclick="openModal('gelombang')" style="background: #10b981; border-radius: 8px; padding: 10px 20px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                    <i class="fas fa-plus"></i> Tambah Gelombang
                </button>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">No</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Nama Gelombang</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Masa Pendaftaran</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Status</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; text-align: right;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% gelombang.forEach((g, idx) => { 
                            const tglMulai = g.tanggal_mulai ? new Date(g.tanggal_mulai).toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'}) : '-';
                            const tglSelesai = g.tanggal_selesai ? new Date(g.tanggal_selesai).toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'}) : '-';
                        %>
                        <tr style="transition: all 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><%= idx + 1 %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; font-weight: 500; color: #1e293b;"><%= g.nama %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><i class="far fa-calendar-alt" style="margin-right: 5px; color: #64748b;"></i> <%= tglMulai %> &nbsp;-&nbsp; <%= tglSelesai %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9;">
                                <% if(g.status === 'Aktif') { %>
                                    <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Aktif</span>
                                <% } else { %>
                                    <span style="background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Nonaktif</span>
                                <% } %>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: right;">
                                <button data-item="<%= JSON.stringify(g) %>" onclick="openModal('gelombang', true, JSON.parse(this.getAttribute('data-item')))" class="btn-edit" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 5px;"><i class="fas fa-edit"></i> Edit</button>
                                <button onclick="deleteData('gelombang', <%= g.id %>)" class="btn-delete" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;"><i class="fas fa-trash"></i> Hapus</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- JALUR -->
    <div id="tab-jalur" class="tab-content-section" style="display: none;">
        <div class="table-container" style="border-radius: var(--radius-md); border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
            <div class="table-header">
                <h5 class="table-title" style="margin: 0; color: #1e293b; font-weight: 700;">Daftar Jalur Pendaftaran</h5>
                <button class="btn btn-primary" onclick="openModal('jalur')" style="background: #10b981; border-radius: 8px; padding: 10px 20px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                    <i class="fas fa-plus"></i> Tambah Jalur
                </button>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">No</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Nama Jalur</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Biaya Formulir</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase;">Status</th>
                            <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; text-align: right;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jalur.forEach((jl, idx) => { %>
                        <tr style="transition: all 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><%= idx + 1 %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; font-weight: 500; color: #1e293b;"><%= jl.nama %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569; font-family: monospace; font-size: 14px;">Rp <%= new Intl.NumberFormat('id-ID').format(jl.biaya) %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9;">
                                <% if(jl.status === 'Aktif') { %>
                                    <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Aktif</span>
                                <% } else { %>
                                    <span style="background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Nonaktif</span>
                                <% } %>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: right;">
                                <button data-item="<%= JSON.stringify(jl) %>" onclick="openModal('jalur', true, JSON.parse(this.getAttribute('data-item')))" class="btn-edit" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 5px;"><i class="fas fa-edit"></i> Edit</button>
                                <button onclick="deleteData('jalur', <%= jl.id %>)" class="btn-delete" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;"><i class="fas fa-trash"></i> Hapus</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Form -->
<div id="masterModal" style="display: none; position: fixed; z-index: 1050; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); transform: translateY(-20px); transition: transform 0.3s ease; overflow: hidden;">
        <div style="padding: 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; background: #f8fafc;">
            <h5 id="modalTitle" style="margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;">Tambah Data</h5>
            <button type="button" onclick="closeModal()" style="border: none; background: none; font-size: 24px; color: #94a3b8; cursor: pointer; transition: color 0.2s;">&times;</button>
        </div>
        <div style="padding: 24px;">
            <form id="masterForm">
                <input type="hidden" id="formType">
                <input type="hidden" id="dataId" name="id">
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Nama</label>
                    <input type="text" id="m_nama" name="nama" required style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                
                <!-- Jenjang Specific -->
                <div class="jenjang-only" style="margin-bottom: 20px; display:none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Kuota Maksimal</label>
                    <input type="number" id="m_kuota" name="kuota" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                
                <div class="gelombang-only" style="margin-bottom: 20px; display:none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Tanggal Mulai</label>
                    <input type="date" id="m_tgl_mulai" name="tanggal_mulai" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                <div class="gelombang-only" style="margin-bottom: 20px; display:none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Tanggal Selesai</label>
                    <input type="date" id="m_tgl_selesai" name="tanggal_selesai" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                
                <div class="gelombang-only" style="margin-bottom: 20px; display:none; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <label style="display: block; margin-bottom: 12px; font-size: 14px; font-weight: 700; color: #0f172a;">Konfigurasi Form yang Dibuka</label>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: #334155; cursor: pointer;">
                            <input type="checkbox" id="m_buka_baru" name="buka_pendaftaran_baru" value="1" style="width: 18px; height: 18px; cursor: pointer; accent-color: #10b981;">
                            Buka Pendaftaran Santri Baru (Reguler/Prestasi)
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: #334155; cursor: pointer;">
                            <input type="checkbox" id="m_buka_beasiswa" name="buka_pendaftaran_beasiswa" value="1" style="width: 18px; height: 18px; cursor: pointer; accent-color: #10b981;">
                            Buka Pendaftaran Beasiswa
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: #334155; cursor: pointer;">
                            <input type="checkbox" id="m_buka_ulang" name="buka_daftar_ulang" value="1" style="width: 18px; height: 18px; cursor: pointer; accent-color: #10b981;">
                            Buka Daftar Ulang
                        </label>
                    </div>
                </div>
                
                <!-- Jalur Specific -->
                <div class="jalur-only" style="margin-bottom: 20px; display:none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Biaya Formulir (Rp)</label>
                    <input type="number" id="m_biaya" name="biaya" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                <div class="jalur-only" style="margin-bottom: 20px; display:none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Syarat Dokumen (Pisahkan dengan koma)</label>
                    <input type="text" id="m_syarat" name="syarat_dokumen" placeholder="KTP, Ijazah, dll" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                
                <div style="margin-bottom: 24px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Status</label>
                    <select id="m_status" name="status" class="form-control" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; background-color: white;">
                        <option value="Aktif">Aktif</option>
                        <option value="Nonaktif">Nonaktif</option>
                    </select>
                </div>
                
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px;">
                    <button type="button" onclick="closeModal()" style="padding: 10px 20px; border-radius: 8px; background: #f1f5f9; color: #64748b; font-weight: 600; border: none; cursor: pointer; transition: background 0.2s;">Batal</button>
                    <button type="submit" style="padding: 10px 24px; border-radius: 8px; background: #10b981; color: white; font-weight: 600; border: none; cursor: pointer; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3); transition: background 0.2s;">Simpan Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Tab Script
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content-section').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.nav-tab').forEach(el => {
            el.style.background = 'transparent';
            el.style.color = '#64748b';
            el.classList.remove('active-tab');
        });
        
        document.getElementById('tab-' + tabId).style.display = 'block';
        const activeBtn = document.getElementById('tab-btn-' + tabId);
        activeBtn.style.background = '#e0f2fe';
        activeBtn.style.color = '#0ea5e9';
        activeBtn.classList.add('active-tab');
    }

    function openModal(type, isEdit = false, data = {}) {
        const modal = document.getElementById('masterModal');
        const modalContent = modal.querySelector('div');
        
        let titleName = type.charAt(0).toUpperCase() + type.slice(1);
        document.getElementById('modalTitle').innerText = isEdit ? 'Edit ' + titleName : 'Tambah ' + titleName;
        document.getElementById('formType').value = type;
        document.getElementById('dataId').value = data.id || '';
        document.getElementById('m_nama').value = data.nama || '';
        document.getElementById('m_status').value = data.status || 'Aktif';

        document.querySelectorAll('.jenjang-only, .gelombang-only, .jalur-only').forEach(el => el.style.display = 'none');
        
        if(type === 'jenjang') {
            document.querySelectorAll('.jenjang-only').forEach(el => el.style.display = 'block');
            document.getElementById('m_kuota').value = data.kuota || 0;
        } else if(type === 'gelombang') {
            document.querySelectorAll('.gelombang-only').forEach(el => el.style.display = 'block');
            document.getElementById('m_tgl_mulai').value = data.tanggal_mulai ? data.tanggal_mulai.split('T')[0] : '';
            document.getElementById('m_tgl_selesai').value = data.tanggal_selesai ? data.tanggal_selesai.split('T')[0] : '';
            document.getElementById('m_buka_baru').checked = data.buka_pendaftaran_baru !== undefined ? data.buka_pendaftaran_baru : true;
            document.getElementById('m_buka_beasiswa').checked = data.buka_pendaftaran_beasiswa !== undefined ? data.buka_pendaftaran_beasiswa : true;
            document.getElementById('m_buka_ulang').checked = data.buka_daftar_ulang !== undefined ? data.buka_daftar_ulang : true;
        } else if(type === 'jalur') {
            document.querySelectorAll('.jalur-only').forEach(el => el.style.display = 'block');
            document.getElementById('m_biaya').value = data.biaya || 0;
            document.getElementById('m_syarat').value = data.syarat_dokumen || '';
        }
        
        modal.style.display = 'flex';
        void modal.offsetWidth; // trigger reflow
        modal.style.opacity = '1';
        modalContent.style.transform = 'translateY(0)';
    }

    function closeModal() {
        const modal = document.getElementById('masterModal');
        const modalContent = modal.querySelector('div');
        
        modal.style.opacity = '0';
        modalContent.style.transform = 'translateY(-20px)';
        
        setTimeout(() => {
            modal.style.display = 'none';
            document.getElementById('masterForm').reset();
        }, 300);
    }

    document.getElementById('masterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const type = document.getElementById('formType').value;
        const id = document.getElementById('dataId').value;
        const url = `/superadmin/master-data/${type}/${id ? 'edit/'+id : 'add'}`;
        
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(this)))
        }).then(r => r.json()).then(res => {
            if(res.success) {
                Swal.fire('Berhasil!', 'Data berhasil disimpan.', 'success').then(() => location.reload());
            } else {
                Swal.fire('Gagal!', res.message, 'error');
            }
        });
    });

    function deleteData(type, id) {
        Swal.fire({
            title: 'Hapus Data?',
            text: "Tindakan ini tidak dapat dibatalkan!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#94a3b8',
            confirmButtonText: 'Ya, hapus!',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/superadmin/master-data/${type}/delete/${id}`, { method: 'POST' })
                .then(r => r.json()).then(res => {
                    if(res.success) {
                        Swal.fire('Terhapus!', 'Data telah dihapus.', 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Gagal!', res.message, 'error');
                    }
                });
            }
        });
    }
    
    // Add hover effects for buttons
    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('mouseenter', () => { btn.style.background = '#d97706'; btn.style.color = 'white'; });
        btn.addEventListener('mouseleave', () => { btn.style.background = 'rgba(245, 158, 11, 0.1)'; btn.style.color = '#d97706'; });
    });
    
    document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('mouseenter', () => { btn.style.background = '#ef4444'; btn.style.color = 'white'; });
        btn.addEventListener('mouseleave', () => { btn.style.background = 'rgba(239, 68, 68, 0.1)'; btn.style.color = '#ef4444'; });
    });
</script>

