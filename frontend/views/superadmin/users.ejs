<%- include('partials/header', { title: 'Manajemen Pengguna', activePage: 'users' }) %>

<div class="content-area">
    <div style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border-radius: var(--radius-md); padding: 30px 40px; margin-bottom: 30px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 25px rgba(59, 130, 246, 0.25);">
        <div>
            <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 8px 0; letter-spacing: -0.5px;">Manajemen Pengguna</h1>
            <p style="color: rgba(255,255,255,0.85); margin: 0; font-size: 15px;">Kelola akun admin, panitia, dan atur hak akses sistem SPMB</p>
        </div>
        <div style="background: rgba(255,255,255,0.1); width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px);">
            <i class="fas fa-users-cog" style="font-size: 28px; color: white;"></i>
        </div>
    </div>

    <div class="table-container" style="border-radius: var(--radius-md); border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <div class="table-header">
            <h5 class="table-title" style="margin: 0; color: #1e293b; font-weight: 700;">Daftar Pengguna Sistem</h5>
            <button class="btn btn-primary" onclick="openUserModal(false)" style="background: #3b82f6; border-radius: 8px; padding: 10px 20px; box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);">
                <i class="fas fa-plus"></i> Tambah Pengguna
            </button>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">No</th>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Username</th>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Nama Lengkap</th>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Role</th>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Status</th>
                        <th style="padding: 16px; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #64748b; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; text-align: right;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach((u, idx) => { %>
                        <tr style="transition: all 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;"><%= idx + 1 %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; font-weight: 500; color: #1e293b;"><%= u.username %></td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; color: #475569;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #64748b; font-size: 12px;">
                                        <%= u.nama_lengkap.charAt(0).toUpperCase() %>
                                    </div>
                                    <%= u.nama_lengkap %>
                                </div>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9;">
                                <% if(u.role === 'super_admin') { %>
                                    <span style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Super Admin</span>
                                <% } else if(u.role === 'admin') { %>
                                    <span style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">Admin</span>
                                <% } else { %>
                                    <span style="background: rgba(100, 116, 139, 0.1); color: #64748b; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;"><%= u.role %></span>
                                <% } %>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9;">
                                <% if(u.is_active) { %>
                                    <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fas fa-circle" style="font-size: 8px; margin-right: 4px; vertical-align: middle;"></i> Aktif</span>
                                <% } else { %>
                                    <span style="background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fas fa-circle" style="font-size: 8px; margin-right: 4px; vertical-align: middle;"></i> Nonaktif</span>
                                <% } %>
                            </td>
                            <td style="padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: right;">
                                <button class="btn-edit" data-id="<%= u.id %>" data-username="<%= u.username %>" data-nama="<%= u.nama_lengkap %>" data-role="<%= u.role %>" data-active="<%= u.is_active %>" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 5px;">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <% if(admin.id !== u.id) { %>
                                    <button class="btn-delete" data-id="<%= u.id %>" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: none; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                                        <i class="fas fa-trash"></i> Hapus
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tambah/Edit User -->
<div id="userModal" style="display: none; position: fixed; z-index: 1050; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); transform: translateY(-20px); transition: transform 0.3s ease; overflow: hidden;">
        <div style="padding: 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; background: #f8fafc;">
            <h5 id="userModalTitle" style="margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;">Tambah Pengguna</h5>
            <button type="button" onclick="closeUserModal()" style="border: none; background: none; font-size: 24px; color: #94a3b8; cursor: pointer; transition: color 0.2s;">&times;</button>
        </div>
        <div style="padding: 24px;">
            <form id="userForm">
                <input type="hidden" id="userId" name="id">
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Username</label>
                    <input type="text" id="username" name="username" required style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Nama Lengkap</label>
                    <input type="text" id="nama_lengkap" name="nama_lengkap" required style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">
                        Password
                        <small style="color: #94a3b8; font-weight: 400;">Kosongkan jika tidak diubah</small>
                    </label>
                    <input type="password" id="password" name="password" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; transition: border-color 0.2s;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Role / Hak Akses</label>
                    <select id="role" name="role" required class="form-control" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; background-color: white;">
                        <option value="admin">Admin Biasa</option>
                        <option value="panitia">Panitia</option>
                        <option value="super_admin">Super Admin</option>
                    </select>
                </div>
                <div id="statusGroup" style="margin-bottom: 24px; display: none;">
                    <label style="display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #475569;">Status Akun</label>
                    <select id="is_active" name="is_active" class="form-control" style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; color: #1e293b; outline: none; background-color: white;">
                        <option value="1">Aktif</option>
                        <option value="0">Nonaktif</option>
                    </select>
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px;">
                    <button type="button" onclick="closeUserModal()" style="padding: 10px 20px; border-radius: 8px; background: #f1f5f9; color: #64748b; font-weight: 600; border: none; cursor: pointer; transition: background 0.2s;">Batal</button>
                    <button type="submit" style="padding: 10px 24px; border-radius: 8px; background: #3b82f6; color: white; font-weight: 600; border: none; cursor: pointer; box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3); transition: background 0.2s;">Simpan Pengguna</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openUserModal(isEdit, data = {}) {
        const modal = document.getElementById('userModal');
        const modalContent = modal.querySelector('div');
        
        document.getElementById('userModalTitle').innerText = isEdit ? 'Edit Pengguna' : 'Tambah Pengguna';
        document.getElementById('userId').value = data.id || '';
        document.getElementById('username').value = data.username || '';
        document.getElementById('nama_lengkap').value = data.nama || '';
        document.getElementById('role').value = data.role || 'admin';
        document.getElementById('password').required = !isEdit;
        
        if (isEdit) {
            document.getElementById('statusGroup').style.display = 'block';
            document.getElementById('is_active').value = data.active;
        } else {
            document.getElementById('statusGroup').style.display = 'none';
        }
        
        modal.style.display = 'flex';
        // Trigger reflow
        void modal.offsetWidth;
        modal.style.opacity = '1';
        modalContent.style.transform = 'translateY(0)';
    }

    function closeUserModal() {
        const modal = document.getElementById('userModal');
        const modalContent = modal.querySelector('div');
        
        modal.style.opacity = '0';
        modalContent.style.transform = 'translateY(-20px)';
        
        setTimeout(() => {
            modal.style.display = 'none';
            document.getElementById('userForm').reset();
        }, 300);
    }

    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', function() {
            openUserModal(true, {
                id: this.dataset.id,
                username: this.dataset.username,
                nama: this.dataset.nama,
                role: this.dataset.role,
                active: this.dataset.active
            });
        });
    });

    document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', function() {
            Swal.fire({
                title: 'Hapus Pengguna?',
                text: "Anda tidak dapat mengembalikan akun yang telah dihapus!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Ya, hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/superadmin/users/delete/' + this.dataset.id, {
                        method: 'POST'
                    }).then(res => res.json()).then(data => {
                        if(data.success) {
                            Swal.fire('Terhapus!', 'Pengguna telah dihapus.', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Gagal!', data.message, 'error');
                        }
                    });
                }
            });
        });
    });

    document.getElementById('userForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const id = document.getElementById('userId').value;
        const url = id ? `/superadmin/users/edit/${id}` : '/superadmin/users/add';
        const formData = new FormData(this);
        const body = Object.fromEntries(formData);
        
        fetch(url, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(body)
        }).then(res => res.json()).then(data => {
            if(data.success) {
                Swal.fire('Berhasil!', 'Data pengguna telah disimpan.', 'success').then(() => location.reload());
            } else {
                Swal.fire('Gagal!', data.message, 'error');
            }
        });
    });
    
    // Add hover effects for buttons
    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('mouseenter', () => { btn.style.background = '#d97706'; btn.style.color = 'white'; });
        btn.addEventListener('mouseleave', () => { btn.style.background = 'rgba(245, 158, 11, 0.1)'; btn.style.color = '#d97706'; });
    });
    
    document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('mouseenter', () => { btn.style.background = '#ef4444'; btn.style.color = 'white'; });
        btn.addEventListener('mouseleave', () => { btn.style.background = 'rgba(239, 68, 68, 0.1)'; btn.style.color = '#ef4444'; });
    });
</script>

<%- include('partials/footer') %>
