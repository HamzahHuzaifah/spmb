<%- include('partials/header', { title: 'Dashboard Super Admin', activePage: 'dashboard' }) %>

<div class="content-area">
    <div style="background: linear-gradient(135deg, #4c1d95 0%, #7c3aed 100%); border-radius: var(--radius-md); padding: 35px 40px; margin-bottom: 35px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 25px rgba(124, 58, 237, 0.25); position: relative; overflow: hidden;">
        <div style="position: relative; z-index: 2;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <span style="background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; letter-spacing: 1px; backdrop-filter: blur(5px); text-transform: uppercase;">Akses Terbatas</span>
            </div>
            <h1 style="font-size: 32px; font-weight: 800; margin: 0 0 10px 0; letter-spacing: -0.5px;">Dashboard Super Admin</h1>
            <p style="color: rgba(255,255,255,0.85); margin: 0; font-size: 15px; max-width: 550px; line-height: 1.6;">Pusat kendali utama sistem SPMB JIC. Anda memiliki otoritas penuh untuk mengelola pengguna, data akademik, jadwal, dan memantau seluruh aktivitas sistem.</p>
        </div>
        <div style="background: rgba(255,255,255,0.1); width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); box-shadow: inset 0 0 20px rgba(255,255,255,0.2); position: relative; z-index: 2;">
            <i class="fas fa-shield-alt" style="font-size: 40px; color: white;"></i>
        </div>
        <!-- Decorative bg elements -->
        <div style="position: absolute; right: -50px; top: -50px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%); border-radius: 50%;"></div>
        <div style="position: absolute; left: 30%; bottom: -100px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%); border-radius: 50%;"></div>
    </div>

    <div class="grid-cards" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <div class="stat-card" style="border-top: none; background: white; padding: 30px;">
            <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(59, 130, 246, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <i class="fas fa-users-cog" style="color: #3b82f6; font-size: 24px;"></i>
            </div>
            <div class="stat-title" style="color: #64748b; margin-bottom: 8px;">Manajemen Pengguna</div>
            <div class="stat-value" style="font-size: 22px; color: #1e293b; margin-bottom: 20px;">Kelola Admin</div>
            <a href="/superadmin/users" class="btn" style="background: #f1f5f9; color: #3b82f6; width: 100%; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='#3b82f6'; this.style.color='white';" onmouseout="this.style.background='#f1f5f9'; this.style.color='#3b82f6';">Buka Manajemen <i class="fas fa-arrow-right"></i></a>
        </div>
        
        <div class="stat-card" style="border-top: none; background: white; padding: 30px;">
            <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(16, 185, 129, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <i class="fas fa-database" style="color: #10b981; font-size: 24px;"></i>
            </div>
            <div class="stat-title" style="color: #64748b; margin-bottom: 8px;">Konfigurasi Sistem</div>
            <div class="stat-value" style="font-size: 22px; color: #1e293b; margin-bottom: 20px;">Master Data</div>
            <a href="/superadmin/master-data" class="btn" style="background: #f1f5f9; color: #10b981; width: 100%; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='#10b981'; this.style.color='white';" onmouseout="this.style.background='#f1f5f9'; this.style.color='#10b981';">Buka Konfigurasi <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="stat-card" style="border-top: none; background: white; padding: 30px;">
            <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(245, 158, 11, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <i class="fas fa-history" style="color: #f59e0b; font-size: 24px;"></i>
            </div>
            <div class="stat-title" style="color: #64748b; margin-bottom: 8px;">Pemantauan</div>
            <div class="stat-value" style="font-size: 22px; color: #1e293b; margin-bottom: 20px;">Log Aktivitas</div>
            <a href="/superadmin/logs" class="btn" style="background: #f1f5f9; color: #d97706; width: 100%; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='#f59e0b'; this.style.color='white';" onmouseout="this.style.background='#f1f5f9'; this.style.color='#d97706';">Buka Log Sistem <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
