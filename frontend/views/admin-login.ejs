<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - SPMB Madrasah JIC</title>
    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/Logo%20Madrasah.webp">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin-login.css?v=2">
</head>
<body>
    <div class="login-split-layout">
        <!-- LEFT LAYER: Welcome & Institutional Showcase -->
        <aside class="login-welcome-panel">
            <div class="welcome-bg-pattern"></div>
            <div class="welcome-glow-top"></div>
            <div class="welcome-glow-bottom"></div>

            <div class="welcome-content-top">
                <a href="/" class="welcome-brand-header">
                    <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC" class="welcome-brand-logo">
                    <div class="welcome-brand-meta">
                        <span class="welcome-brand-name">MADRASAH JIC</span>
                        <span class="welcome-brand-loc">Jakarta Islamic Centre</span>
                    </div>
                </a>

                <div class="welcome-badge">
                    <span class="welcome-badge-dot"></span>
                    <span>Portal Administrasi &amp; Keuangan Terpadu &bull; T.A <%= typeof tahunAjaranAktif !== 'undefined' ? tahunAjaranAktif : '2026/2027' %></span>
                </div>

                <h1 class="welcome-title">
                    Selamat Datang di Panel Manajemen <span>SPMB Madrasah JIC</span>
                </h1>

                <p class="welcome-description">
                    Pusat kendali pendaftaran santri baru, daftar ulang kenaikan tingkat, verifikasi beasiswa, serta pengelolaan tagihan dan laporan keuangan secara real-time.
                </p>

                <div class="welcome-feature-list">
                    <div class="welcome-feature-item">
                        <div class="feature-icon-box">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div class="feature-text-box">
                            <h4>Manajemen Data Santri &amp; Kuota</h4>
                            <p>Pantau pendaftar baru, daftar ulang, dan ketersediaan kuota per jenjang (PAUDQu, TPQ, MDT).</p>
                        </div>
                    </div>

                    <div class="welcome-feature-item">
                        <div class="feature-icon-box">
                            <i class="fas fa-file-invoice-dollar"></i>
                        </div>
                        <div class="feature-text-box">
                            <h4>Integrasi Tagihan, Kwitansi &amp; SIKMA</h4>
                            <p>Pencatatan pembayaran otomatis, cetak kwitansi resmi, dan sinkronisasi keuangan dengan SIKMA.</p>
                        </div>
                    </div>

                    <div class="welcome-feature-item">
                        <div class="feature-icon-box">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="feature-text-box">
                            <h4>Multi-Tahun Ajaran &amp; Arsip Terpusat</h4>
                            <p>Beralih antar periode tahun ajaran dengan cepat tanpa kehilangan histori data tahun sebelumnya.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="welcome-content-footer">
                <div class="welcome-footer-info">
                    <i class="fas fa-shield-alt"></i>
                    <span>Akses Terproteksi &mdash; Khusus Panitia &amp; Administrator Resmi Madrasah JIC</span>
                </div>
            </div>
        </aside>

        <!-- RIGHT LAYER: Login Form Panel -->
        <main class="login-form-panel">
            <div class="login-form-container">
                <div class="login-mobile-brand">
                    <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC">
                    <div>
                        <strong>SPMB Madrasah JIC</strong>
                        <span>Portal Administrasi &amp; Keuangan</span>
                    </div>
                </div>

                <div class="login-header">
                    <span class="login-eyebrow">Otentikasi Pengguna</span>
                    <h2>Masuk ke Akun Admin</h2>
                    <p>Silakan masukkan kredensial akun Anda untuk mengakses dashboard.</p>
                </div>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-msg" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>
                
                <form action="/login" method="POST" id="loginForm">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-icon-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            <input type="text" id="username" name="username" class="form-control" required autocomplete="username" placeholder="Masukkan username admin" autofocus>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-icon-wrapper">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password" id="password" name="password" class="form-control" required autocomplete="current-password" placeholder="Masukkan password">
                            <button type="button" class="toggle-password-btn" aria-label="Tampilkan Password">
                                <i class="fas fa-eye toggle-password" id="togglePassword"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        <span>Masuk ke Dashboard</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>

                <div class="login-footer-links">
                    <a href="/" class="back-to-public-link">
                        <i class="fas fa-arrow-left"></i> Kembali ke Halaman Utama Pendaftaran
                    </a>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/admin-login.js"></script>
</body>
</html>
