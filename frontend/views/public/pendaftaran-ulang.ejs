<div class="premium-form-card">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 15px; margin-bottom: 15px;">
        <h2 style="margin: 0; border: none; padding: 0;"><i class="fas fa-sync-alt" style="margin-right: 10px; color: var(--primary);"></i> Form Pendaftaran Ulang</h2>
    </div>
    <p style="margin-bottom: 25px; color: var(--text-muted);">Silakan lengkapi data diri santri yang akan mendaftar ulang (naik tingkat).</p>

    <%- include('../partials/public-alert', { error: typeof error !== 'undefined' ? error : null }) %>

    <%- include('../partials/terms-card', { type: 'ulang' }) %>

    <form action="/daftar-ulang" method="POST">
        <!-- Data Santri -->
        <h3 style="margin-bottom: 15px; color: var(--text-main);"><i class="fas fa-user-graduate" style="margin-right: 10px; color: var(--primary);"></i> A. Data Calon Santri</h3>

        <%- include('../partials/public-jalur-selector', {
            mode: 'ulang',
            inputName: 'jalurPendaftaran',
            jalurList: typeof jalurList !== 'undefined' ? jalurList : []
        }) %>

        <div class="form-group">
            <label class="required">Unit / Satuan Pendidikan Sebelumnya</label>
            <%- include('../partials/select-pendidikan', { 
                type: 'form_unit_sebelumnya',
                name: 'pendidikanSebelumnya',
                id: 'pendidikanSebelumnya',
                className: 'form-input',
                required: true,
                placeholder: '-- Pilih Tingkat Sebelumnya --',
                selectedValue: typeof formData !== 'undefined' && formData.pendidikanSebelumnya ? formData.pendidikanSebelumnya : '',
                isDaftarUlang: true
            }) %>
        </div>

        <div class="form-group">
            <label class="required">Tujuan / Lanjut Ke Tingkat</label>
            <%- include('../partials/select-pendidikan', { 
                type: 'form_lanjut_ke',
                name: 'lanjutKe',
                id: 'lanjutKe',
                className: 'form-input',
                required: true,
                placeholder: '-- Pilih Tujuan Tingkat --',
                selectedValue: typeof formData !== 'undefined' && formData.lanjutKe ? formData.lanjutKe : '',
                isDaftarUlang: true
            }) %>
        </div>

        <%- include('../partials/form-data-santri', { useNameSelect: true }) %>

        <hr style="border: 0; border-top: 1px dashed var(--border); margin: 30px 0;">

        <!-- Data Orang Tua -->
        <h3 style="margin-bottom: 15px; color: var(--text-main);"><i class="fas fa-users" style="margin-right: 10px; color: var(--primary);"></i> B. Data Orang Tua / Wali</h3>

        <%- include('../partials/form-orang-tua', { 
            layout: 'stacked',
            groupClass: 'form-group',
            showEmail: true,
            required: true
        }) %>

        <hr style="border: 0; border-top: 1px dashed var(--border); margin: 30px 0;">

        <div style="margin-top: 40px;">
            <button type="submit" class="btn-submit">Kirim Pendaftaran Ulang</button>
        </div>

        <%- include('../partials/public-nav-group', { currentForm: 'ulang' }) %>
    </form>
</div>
