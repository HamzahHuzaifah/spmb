
<div class="hero-section">
    <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC" style="height: 120px; margin-bottom: 20px; filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.7));">
    <h3 class="hero-title" style="margin-bottom: 0;">Sistem Penerimaan Murid Baru</h3>
    <h1 class="hero-title" style="margin-top: 5px;">Madrasah Jakarta Islamic Centre</h1>
    <p class="hero-subtitle">
        Pusat pendidikan usia dini dan dasar yang membentuk generasi rabbani, berakhlak mulia, dan berprestasi. Sistem Penerimaan Murid Baru Terpadu Tahun Ajaran 2026/2027.
    </p>
    <div>
        <a href="#layanan" class="cta-button">Eksplorasi Layanan</a>
        <a href="/daftar" class="cta-button-outline">Daftar Sekarang</a>
    </div>
</div>

<div class="services-container" id="layanan">
    <h2 class="section-title">Informasi Kuota Pendaftaran</h2>
    <style>
        .kuota-grid { display: flex; flex-wrap: nowrap; justify-content: center; gap: 12px; margin-bottom: 50px; width: 100%; }
        .kuota-grid .kuota-item { background: white; border-radius: 12px; padding: 12px 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; flex: 0 1 auto; white-space: nowrap; }
        @media (max-width: 768px) { .kuota-grid { flex-wrap: wrap; } }
    </style>
    <div class="kuota-grid">
        <% if (typeof jenjangList !== 'undefined' && jenjangList.length > 0) { %>
            <% jenjangList.forEach(j => { %>
                <div class="kuota-item" style="border-bottom: 4px solid <%= j.sisaKuota > 0 ? '#10b981' : '#ef4444' %>;">
                    <div style="font-weight: bold; color: var(--text-main); font-size: 15px; margin-bottom: 5px;"><%= j.nama %></div>
                    <div style="color: <%= j.sisaKuota > 0 ? '#10b981' : '#ef4444' %>; font-size: 13px; font-weight: 600;">
                        <%= j.sisaKuota > 0 ? `Sisa Kuota: ${j.sisaKuota}` : 'Kuota Penuh' %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <h2 class="section-title">Layanan Wali Santri</h2>
    
    <div class="services-grid">
        <!-- Card: Reguler -->
        <a href="/daftar" class="service-card">
            <div class="service-icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <h3 class="service-title">Pendaftaran Reguler</h3>
            <p class="service-desc">
                Pendaftaran santri baru untuk jenjang PAUDQu, TPQ, dan MDT melalui jalur reguler umum.
            </p>
        </a>

        <!-- Card: Beasiswa -->
        <a href="/daftar/beasiswa" class="service-card">
            <div class="service-icon">
                <i class="fas fa-hand-holding-heart"></i>
            </div>
            <h3 class="service-title">Pendaftaran Beasiswa</h3>
            <p class="service-desc">
                Jalur pendaftaran beasiswa khusus bagi kaum dhuafa, yatim piatu, dan komunitas/pekerja di JIC.
            </p>
        </a>

        <!-- Card: Daftar Ulang -->
        <a href="/daftar-ulang" class="service-card">
            <div class="service-icon">
                <i class="fas fa-sync-alt"></i>
            </div>
            <h3 class="service-title">Daftar Ulang</h3>
            <p class="service-desc" style="margin-bottom: 10px;">
                Pendaftaran ulang bagi santri lama yang naik tingkat:
            </p>
            <ul style="text-align: left; padding-left: 20px; list-style-type: disc; color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin: 0 auto; display: table;">
                <li>PAUDQu A &rarr; PAUDQu B</li>
                <li>PAUDQu B &rarr; TPQ A</li>
                <li>TPQ A &rarr; TPQ B</li>
                <li>TPQ B &rarr; MDT 1</li>
                <li>MDT 1 &rarr; MDT 2-4</li>
            </ul>
        </a>



        <!-- Card: Tagihan & Pembayaran -->
        <a href="/info-pembayaran" class="service-card">
            <div class="service-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <h3 class="service-title">Info Pembayaran</h3>
            <p class="service-desc">
                Cek tagihan pembayaran pendaftaran santri dengan mudah.
            </p>
        </a>

        <!-- Card: Web Madrasah Jakarta Islamic Centre -->
        <a href="https://mjic.sch.id" target="_blank" class="service-card">
            <div class="service-icon">
                <i class="fas fa-globe"></i>
            </div>
            <h3 class="service-title">Web Madrasah JIC</h3>
            <p class="service-desc">
                Kunjungi website resmi Madrasah Jakarta Islamic Centre untuk informasi seputar sekolah.
            </p>
        </a>
    </div>
</div>

<footer>
    <div style="margin-bottom: 10px; font-weight: bold; color: white;">Madrasah Jakarta Islamic Centre</div>
    <p>&copy; 2026 Sistem Penerimaan Murid Baru. Seluruh Hak Cipta Dilindungi.</p>
</footer>
