<%
const taText = typeof tahunAjaranAktif !== 'undefined' ? tahunAjaranAktif : '2026/2027';
const gelName = (typeof activeGelombang !== 'undefined' && activeGelombang && activeGelombang.nama) ? activeGelombang.nama : 'Pendaftaran Aktif';
const jbSlides = (typeof jumbotronList !== 'undefined' && Array.isArray(jumbotronList)) ? jumbotronList : [];
const jbIntervalSec = (typeof jumbotronInterval !== 'undefined' && jumbotronInterval) ? parseInt(jumbotronInterval, 10) : 5;
const jbOverlayPct = (typeof jumbotronOverlay !== 'undefined' && jumbotronOverlay) ? parseInt(jumbotronOverlay, 10) : 65;
const jbOverlayAlpha = (Math.max(25, Math.min(92, jbOverlayPct)) / 100).toFixed(2);
%>

<!-- Top Navigation Bar -->
<header class="landing-navbar">
    <div class="landing-navbar-inner">
        <a href="/" class="landing-brand">
            <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC" class="landing-brand-logo">
            <div class="landing-brand-text">
                <span class="landing-brand-title">Madrasah JIC</span>
                <span class="landing-brand-sub">Jakarta Islamic Centre</span>
            </div>
        </a>

        <nav class="landing-nav-links">
            <a href="#jalur-pendaftaran" class="landing-nav-link">Jalur Pendaftaran</a>
            <a href="#kuota" class="landing-nav-link">Kuota Kelas</a>
            <a href="#alur" class="landing-nav-link">Alur Pendaftaran</a>
            <a href="/info-pembayaran" class="landing-nav-link"><i class="fas fa-receipt"></i> Cek Tagihan</a>
        </nav>

        <div class="landing-nav-actions">
            <a href="/daftar-ulang" class="landing-btn-nav-outline">Daftar Ulang</a>
            <a href="/daftar" class="landing-btn-nav-primary">
                <i class="fas fa-edit"></i> Daftar Santri Baru
            </a>
        </div>
    </div>
</header>

<!-- Hero / Jumbotron Section -->
<section class="hero-section <%= jbSlides.length > 0 ? 'has-jumbotron-slider' : '' %>" data-jumbotron-interval="<%= jbIntervalSec * 1000 %>">
    <% if (jbSlides.length > 0) { %>
    <div class="hero-jumbotron-stage" aria-hidden="true">
        <% jbSlides.forEach((slide, idx) => { %>
            <div class="hero-jumbotron-slide <%= idx === 0 ? 'is-active' : '' %>"
                 style="background-image: url('<%= slide.image_url %>');"
                 data-caption="<%= slide.judul || '' %>"></div>
        <% }) %>
        <div class="hero-jumbotron-overlay" style="background: linear-gradient(160deg, rgba(6, 78, 59, <%= jbOverlayAlpha %>) 0%, rgba(2, 44, 34, <%= Math.min(0.95, parseFloat(jbOverlayAlpha) + 0.14).toFixed(2) %>) 100%);"></div>
    </div>
    <% } %>

    <div class="hero-inner">
        <div class="hero-logo-wrap">
            <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC" class="hero-emblem-logo">
        </div>

        <div class="hero-status-pill">
            <span class="status-dot"></span>
            <span>SPMB Tahun Ajaran <strong><%= taText %></strong> &bull; <%= gelName %></span>
        </div>

        <h1 class="hero-heading">
            <span class="hero-heading-main">Sistem Penerimaan Santri Baru &amp; Daftar Ulang</span>
            <span class="hero-heading-sub">Madrasah Jakarta Islamic Centre</span>
        </h1>

        <p class="hero-subtitle">
            Pendidikan Al-Qur'an usia dini dan dasar (PAUDQu, TPQ, dan MDT) yang terarah untuk membentuk generasi berakhlak mulia. Pilih jalur pendaftaran di bawah ini untuk memulai pengisian formulir:
        </p>

        <% if (jbSlides.length > 1) { %>
        <div class="hero-jumbotron-controls" aria-label="Navigasi Slide Jumbotron">
            <% jbSlides.forEach((slide, idx) => { %>
                <button type="button" class="hero-jumbotron-dot <%= idx === 0 ? 'is-active' : '' %>" data-slide-to="<%= idx %>" title="<%= slide.judul || ('Slide ' + (idx + 1)) %>" aria-label="Slide <%= idx + 1 %>"></button>
            <% }) %>
        </div>
        <% } %>

        <!-- Primary Action Dock: Langsung terlihat jelas oleh wali murid saat pertama membuka web -->
        <div class="hero-action-dock" id="jalur-pendaftaran">
            <div class="hero-dock-label">
                <i class="fas fa-hand-pointer"></i> Pilih Formulir Pendaftaran Sesuai Kebutuhan Anda:
            </div>

            <div class="hero-cta-cards">
                <!-- Tombol Utama 1: Santri Baru Reguler -->
                <a href="/daftar" class="hero-cta-card hero-cta-primary">
                    <div class="hero-cta-top">
                        <div class="hero-cta-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <span class="hero-cta-tag">Santri Baru</span>
                    </div>
                    <div class="hero-cta-body">
                        <h3>Daftar Santri Baru (Reguler)</h3>
                        <p>Formulir pendaftaran murid baru jenjang PAUDQu, TPQ, atau MDT jalur umum.</p>
                    </div>
                    <div class="hero-cta-footer">
                        <span>Buka Formulir Pendaftaran</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>

                <!-- Tombol Utama 2: Daftar Ulang / Naik Kelas -->
                <a href="/daftar-ulang" class="hero-cta-card hero-cta-ulang">
                    <div class="hero-cta-top">
                        <div class="hero-cta-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <span class="hero-cta-tag">Santri Lama</span>
                    </div>
                    <div class="hero-cta-body">
                        <h3>Daftar Ulang (Naik Tingkat)</h3>
                        <p>Khusus santri aktif tahun ajaran sebelumnya yang naik jenjang/kelas berikutnya.</p>
                    </div>
                    <div class="hero-cta-footer">
                        <span>Buka Formulir Daftar Ulang</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>

                <!-- Tombol Utama 3: Jalur Beasiswa -->
                <a href="/daftar/beasiswa" class="hero-cta-card hero-cta-beasiswa">
                    <div class="hero-cta-top">
                        <div class="hero-cta-icon">
                            <i class="fas fa-hand-holding-heart"></i>
                        </div>
                        <span class="hero-cta-tag">Khusus &amp; Subsidi</span>
                    </div>
                    <div class="hero-cta-body">
                        <h3>Daftar Jalur Beasiswa</h3>
                        <p>Program keringanan biaya bagi Dhuafa, Yatim/Piatu, Bersaudara &amp; Pegawai/Komunitas JIC.</p>
                    </div>
                    <div class="hero-cta-footer">
                        <span>Buka Formulir Beasiswa</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>
            </div>

            <!-- Baris Aksi Sekunder: Cek Tagihan & Eksplorasi -->
            <div class="hero-secondary-bar">
                <div class="hero-secondary-text">
                    <i class="fas fa-info-circle"></i> Sudah mendaftar sebelumnya dan memiliki Nomor Pendaftaran?
                </div>
                <div class="hero-secondary-buttons">
                    <a href="/info-pembayaran" class="hero-btn-utility">
                        <i class="fas fa-wallet"></i> Cek Info Tagihan &amp; Pembayaran
                    </a>
                    <a href="#layanan" class="hero-btn-scroll">
                        Lihat Detail Layanan &amp; Kuota <i class="fas fa-chevron-down"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Content Container -->
<div class="services-container" id="layanan">

    <!-- Section 1: Informasi Kuota Pendaftaran -->
    <section class="landing-section" id="kuota">
        <div class="section-header">
            <div>
                <span class="section-eyebrow">Ketersediaan Bangku T.A <%= taText %></span>
                <h2 class="section-title-left">Informasi Kuota Pendaftaran</h2>
            </div>
            <p class="section-header-note">
                Data sisa kuota diperbarui secara otomatis berdasarkan jumlah pendaftar pada masing-masing kelas.
            </p>
        </div>

        <div class="kuota-grid">
            <% if (typeof jenjangList !== 'undefined' && jenjangList.length > 0) { %>
                <% jenjangList.forEach(j => { 
                    const kuotaMax = parseInt(j.kuota, 10) || 0;
                    const sisa = parseInt(j.sisaKuota, 10) || 0;
                    const terisi = typeof j.terisi !== 'undefined' ? parseInt(j.terisi, 10) : Math.max(0, kuotaMax - sisa);
                    const pct = kuotaMax > 0 ? Math.min(100, Math.round((terisi / kuotaMax) * 100)) : 100;
                    const isFull = sisa <= 0;
                    const isLow = !isFull && sisa <= 5;
                    const statusClass = isFull ? 'kuota-full' : (isLow ? 'kuota-low' : 'kuota-open');
                %>
                    <div class="kuota-card <%= statusClass %>">
                        <div class="kuota-card-top">
                            <span class="kuota-jenjang-name"><%= j.nama %></span>
                            <span class="kuota-status-badge">
                                <%= isFull ? 'Penuh' : (isLow ? 'Hampir Penuh' : 'Tersedia') %>
                            </span>
                        </div>
                        <div class="kuota-number-row">
                            <div class="kuota-remaining">
                                <span class="kuota-remaining-val"><%= sisa %></span>
                                <span class="kuota-remaining-lbl">kursi tersisa</span>
                            </div>
                            <span class="kuota-capacity">dari <%= kuotaMax %> kuota</span>
                        </div>
                        <div class="kuota-progress-track">
                            <div class="kuota-progress-bar" style="width: <%= pct %>%;"></div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </section>

    <!-- Section 2: Panduan Singkat 4 Langkah Pendaftaran -->
    <section class="landing-section" id="alur">
        <div class="section-header">
            <div>
                <span class="section-eyebrow">Panduan Wali Santri</span>
                <h2 class="section-title-left">Alur Pendaftaran Online</h2>
            </div>
            <p class="section-header-note">
                Proses pendaftaran dilakukan secara daring dalam 4 langkah mudah tanpa perlu antre.
            </p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-num">1</div>
                <div class="step-content">
                    <h3>Pilih Jalur Pendaftaran</h3>
                    <p>Pilih <strong>Pendaftaran Reguler</strong> atau <strong>Beasiswa</strong> untuk santri baru, atau <strong>Daftar Ulang</strong> bagi santri lama yang naik tingkat.</p>
                </div>
            </div>
            <div class="step-card">
                <div class="step-num">2</div>
                <div class="step-content">
                    <h3>Isi Formulir Biodata</h3>
                    <p>Lengkapi data calon santri dan orang tua/wali. Untuk daftar ulang, pilih kelas asal untuk memunculkan nama santri secara otomatis.</p>
                </div>
            </div>
            <div class="step-card">
                <div class="step-num">3</div>
                <div class="step-content">
                    <h3>Simpan Nomor Pendaftaran</h3>
                    <p>Setelah formulir dikirim, sistem akan menerbitkan <strong>Nomor Referensi Pendaftaran</strong> (contoh: <code>SPMB-Daftar.Baru/<%= taText.split('/')[0] %>/MJIC/001</code>).</p>
                </div>
            </div>
            <div class="step-card">
                <div class="step-num">4</div>
                <div class="step-content">
                    <h3>Cek Tagihan &amp; Pembayaran</h3>
                    <p>Gunakan menu <strong>Info Pembayaran</strong> untuk melihat rincian biaya pendidikan, status pembayaran, atau konfirmasi ke panitia.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Layanan Wali Santri (Lengkap Semua Menu) -->
    <section class="landing-section">
        <div class="section-header">
            <div>
                <span class="section-eyebrow">Menu &amp; Direktori</span>
                <h2 class="section-title-left">Layanan Wali Santri</h2>
            </div>
            <p class="section-header-note">
                Akses seluruh layanan pendaftaran, informasi biaya, dan portal resmi Madrasah JIC.
            </p>
        </div>

        <div class="services-grid">
            <!-- Card: Reguler -->
            <a href="/daftar" class="service-card service-card-emerald">
                <div class="service-card-head">
                    <div class="service-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <span class="service-badge">Santri Baru</span>
                </div>
                <h3 class="service-title">Pendaftaran Reguler</h3>
                <p class="service-desc">
                    Pendaftaran santri baru untuk jenjang PAUDQu, TPQ, dan MDT melalui jalur reguler umum.
                </p>
                <div class="service-action">
                    <span>Daftar Jalur Reguler</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <!-- Card: Beasiswa -->
            <a href="/daftar/beasiswa" class="service-card service-card-amber">
                <div class="service-card-head">
                    <div class="service-icon">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <span class="service-badge">Subsidi Biaya</span>
                </div>
                <h3 class="service-title">Pendaftaran Beasiswa</h3>
                <p class="service-desc">
                    Jalur pendaftaran beasiswa khusus bagi kaum dhuafa, yatim piatu, satu keluarga, dan komunitas/pekerja di JIC.
                </p>
                <div class="service-action">
                    <span>Daftar Jalur Beasiswa</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <!-- Card: Daftar Ulang -->
            <a href="/daftar-ulang" class="service-card service-card-indigo">
                <div class="service-card-head">
                    <div class="service-icon">
                        <i class="fas fa-sync-alt"></i>
                    </div>
                    <span class="service-badge">Naik Tingkat</span>
                </div>
                <h3 class="service-title">Daftar Ulang</h3>
                <p class="service-desc" style="margin-bottom: 12px;">
                    Pendaftaran ulang bagi santri lama yang naik tingkat:
                </p>
                <ul class="service-level-list">
                    <li><span>PAUDQu A</span> <i class="fas fa-long-arrow-alt-right"></i> <span>PAUDQu B</span></li>
                    <li><span>PAUDQu B</span> <i class="fas fa-long-arrow-alt-right"></i> <span>TPQ A</span></li>
                    <li><span>TPQ A</span> <i class="fas fa-long-arrow-alt-right"></i> <span>TPQ B</span></li>
                    <li><span>TPQ B</span> <i class="fas fa-long-arrow-alt-right"></i> <span>MDT 1</span></li>
                    <li><span>MDT 1</span> <i class="fas fa-long-arrow-alt-right"></i> <span>MDT 2–4</span></li>
                </ul>
                <div class="service-action">
                    <span>Isi Form Daftar Ulang</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <!-- Card: Tagihan & Pembayaran -->
            <a href="/info-pembayaran" class="service-card service-card-teal">
                <div class="service-card-head">
                    <div class="service-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <span class="service-badge">Cek Status</span>
                </div>
                <h3 class="service-title">Info Pembayaran</h3>
                <p class="service-desc">
                    Cek rincian tagihan, total yang sudah dibayarkan, dan sisa tunggakan pendaftaran menggunakan Nomor Pendaftaran atau Nama Santri.
                </p>
                <div class="service-action">
                    <span>Cek Tagihan Pembayaran</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <!-- Card: Web Madrasah Jakarta Islamic Centre -->
            <a href="https://mjic.sch.id" target="_blank" rel="noopener noreferrer" class="service-card service-card-slate">
                <div class="service-card-head">
                    <div class="service-icon">
                        <i class="fas fa-globe"></i>
                    </div>
                    <span class="service-badge">Portal Resmi</span>
                </div>
                <h3 class="service-title">Web Madrasah JIC</h3>
                <p class="service-desc">
                    Kunjungi website resmi Madrasah Jakarta Islamic Centre untuk profil lembaga, kurikulum, dan kegiatan santri.
                </p>
                <div class="service-action">
                    <span>Kunjungi mjic.sch.id</span>
                    <i class="fas fa-external-link-alt"></i>
                </div>
            </a>
        </div>
    </section>
</div>

<!-- Footer -->
<footer class="landing-footer">
    <div class="landing-footer-inner">
        <div class="landing-footer-col">
            <div class="landing-footer-brand">
                <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC">
                <div>
                    <h4>Madrasah Jakarta Islamic Centre</h4>
                    <span>PAUDQu &bull; TPQ &bull; MDT</span>
                </div>
            </div>
            <p class="landing-footer-address">
                <i class="fas fa-map-marker-alt"></i>
                Gd. Sosial Budaya Lt. 2, Jl. Kramat Jaya, Tugu Utara, Kec. Koja, Jakarta Utara 14260
            </p>
        </div>

        <div class="landing-footer-col">
            <h5>Akses Cepat Formulir</h5>
            <ul class="landing-footer-links">
                <li><a href="/daftar">Pendaftaran Santri Baru (Reguler)</a></li>
                <li><a href="/daftar-ulang">Pendaftaran Ulang (Naik Tingkat)</a></li>
                <li><a href="/daftar/beasiswa">Pendaftaran Jalur Beasiswa</a></li>
                <li><a href="/info-pembayaran">Cek Info Tagihan &amp; Pembayaran</a></li>
            </ul>
        </div>

        <div class="landing-footer-col">
            <h5>Layanan Informasi Panitia</h5>
            <p style="font-size: 13.5px; color: rgba(255,255,255,0.8); margin-bottom: 12px; line-height: 1.6;">
                Jika mengalami kendala saat mengisi formulir pendaftaran atau daftar ulang, silakan hubungi sekretariat panitia:
            </p>
            <div class="landing-footer-contacts">
                <a href="https://wa.me/6287889969936" target="_blank" rel="noopener noreferrer" class="footer-wa-chip">
                    <i class="fab fa-whatsapp"></i> 0878-8996-9936
                </a>
                <a href="https://wa.me/6285714065288" target="_blank" rel="noopener noreferrer" class="footer-wa-chip">
                    <i class="fab fa-whatsapp"></i> 0857-1406-5288
                </a>
            </div>
        </div>
    </div>

    <div class="landing-footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> Sistem Penerimaan Murid Baru &mdash; Madrasah Jakarta Islamic Centre. Seluruh Hak Cipta Dilindungi.</p>
    </div>
</footer>
