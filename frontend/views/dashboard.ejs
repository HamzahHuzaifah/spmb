<%- include('partials/header', { title: 'Dashboard' , activePage: 'dashboard' }) %>

<div class="content-area">
    <!-- Header -->
    <div class="dashboard-header mb-4" style="border-left: 5px solid var(--primary); padding-left: 15px; margin-bottom: 30px;">
        <h1 style="font-size: 24px; font-weight: 700; color: var(--primary-dark); margin: 0;">Dashboard Informasi Keuangan</h1>
        <p style="color: var(--text-muted); margin: 5px 0 0 0; font-size: 14px;">Ringkasan pendaftaran dan status keuangan SPMB MJIC</p>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar mb-4">
        <form method="GET" action="/dashboard" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; width: 100%;">
            <!-- Filter Fields & Buttons -->
            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label style="font-weight: 600; white-space: nowrap; margin-bottom: 0;">Dari Tanggal:</label>
                    <input type="date" name="startDate" id="startDateInput" class="form-control" style="width: 130px;" value="<%= typeof startDateQuery !== 'undefined' ? startDateQuery : '' %>">
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label style="font-weight: 600; white-space: nowrap; margin-bottom: 0;">Sampai Tanggal:</label>
                    <input type="date" name="endDate" id="endDateInput" class="form-control" style="width: 130px;" value="<%= typeof endDateQuery !== 'undefined' ? endDateQuery : '' %>">
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filter</button>
                <a href="/dashboard" class="btn btn-secondary" style="text-decoration: none;"><i class="fas fa-sync"></i> Reset</a>
            </div>
            
            <!-- Action Buttons -->
            <div style="display: flex; align-items: center;">
                <a href="/dashboard/export-excel?startDate=<%= typeof startDateQuery !== 'undefined' ? startDateQuery : '' %>&endDate=<%= typeof endDateQuery !== 'undefined' ? endDateQuery : '' %>" class="btn btn-secondary btn-print" style="text-decoration: none;" download>
                    <i class="fas fa-file-excel"></i> Export Excel
                </a>
            </div>
        </form>
    </div>

    <!-- Arus Kas Summary Cards (Top Section) -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="arus-kas-card pemasukan">
                <div>
                    <div class="arus-kas-title">TOTAL PEMASUKAN</div>
                    <div class="arus-kas-value" id="valArusPemasukan" data-original="<%= dashboardStats.totalPemasukanGlobal %>">
                        Rp <%= dashboardStats.totalPemasukanGlobal.toLocaleString('id-ID') %>
                    </div>
                </div>
                <div class="arus-kas-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="17" y1="7" x2="7" y2="17"></line>
                        <polyline points="17 17 7 17 7 7"></polyline>
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="arus-kas-card pengeluaran">
                <div>
                    <div class="arus-kas-title">TOTAL PENGELUARAN</div>
                    <div class="arus-kas-value" id="valArusPengeluaran" data-original="<%= dashboardStats.pengeluaranRekap.TOTAL %>">
                        Rp <%= dashboardStats.pengeluaranRekap.TOTAL.toLocaleString('id-ID') %>
                    </div>
                </div>
                <div class="arus-kas-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="arus-kas-card saldo">
                <div>
                    <div class="arus-kas-title">SALDO SPMB</div>
                    <div class="arus-kas-value" id="valArusSaldo" data-original="<%= dashboardStats.totalPemasukanGlobal - dashboardStats.pengeluaranRekap.TOTAL %>">
                        Rp <%= (dashboardStats.totalPemasukanGlobal - dashboardStats.pengeluaranRekap.TOTAL).toLocaleString('id-ID') %>
                    </div>
                </div>
                <div class="arus-kas-icon-box">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Stats -->
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'PENDAPATAN  ',
                id: 'valPendapatan',
                rawValue: dashboardStats.totalPemasukanGlobal,
                formattedValue: 'Rp ' + dashboardStats.totalPemasukanGlobal.toLocaleString('id-ID'),
                iconClass: 'fas fa-wallet'
            }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'TUNGGAKAN',
                id: 'valTopTunggakan',
                rawValue: dashboardStats.totalTunggakan,
                formattedValue: 'Rp ' + dashboardStats.totalTunggakan.toLocaleString('id-ID'),
                iconClass: 'fas fa-file-invoice-dollar',
                iconStyle: 'color: rgba(239, 68, 68, 0.1);'
            }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'TARGET PENDAPATAN',
                id: 'valTopTarget',
                rawValue: dashboardStats.totalTargetPendapatan,
                formattedValue: 'Rp ' + dashboardStats.totalTargetPendapatan.toLocaleString('id-ID'),
                iconClass: 'fas fa-bullseye',
                iconStyle: 'color: rgba(217, 119, 6, 0.1);'
            }) %>
        </div>
    </div>

    <!-- Tunggakan Per Unit Stats -->
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'TUNGGAKAN PAUDQU',
                id: 'valTunggakanPaudqu',
                rawValue: dashboardStats.baru.PAUDQu.tunggakan + dashboardStats.lama.PAUDQu.tunggakan,
                formattedValue: 'Rp ' + (dashboardStats.baru.PAUDQu.tunggakan + dashboardStats.lama.PAUDQu.tunggakan).toLocaleString('id-ID'),
                iconClass: 'fas fa-file-invoice-dollar',
                iconStyle: 'color: rgba(239, 68, 68, 0.1);'
            }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'TUNGGAKAN TPQ',
                id: 'valTunggakanTpq',
                rawValue: dashboardStats.baru.TPQ.tunggakan + dashboardStats.lama.TPQ.tunggakan,
                formattedValue: 'Rp ' + (dashboardStats.baru.TPQ.tunggakan + dashboardStats.lama.TPQ.tunggakan).toLocaleString('id-ID'),
                iconClass: 'fas fa-file-invoice-dollar',
                iconStyle: 'color: rgba(239, 68, 68, 0.1);'
            }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/stat-card', {
                title: 'TUNGGAKAN MDT',
                id: 'valTunggakanMdt',
                rawValue: dashboardStats.baru.MDT.tunggakan + dashboardStats.lama.MDT.tunggakan,
                formattedValue: 'Rp ' + (dashboardStats.baru.MDT.tunggakan + dashboardStats.lama.MDT.tunggakan).toLocaleString('id-ID'),
                iconClass: 'fas fa-file-invoice-dollar',
                iconStyle: 'color: rgba(239, 68, 68, 0.1);'
            }) %>
        </div>
    </div>

    <!-- Pengeluaran & Ziswaf Table -->
    <div class="row mb-4">
        <!-- Pengeluaran -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header"><i class="fas fa-hand-holding-usd mr-2"></i> INFORMASI PENGELUARAN KEUANGAN SPMB</div>
                <div class="table-responsive stat-group" style="overflow-x: auto;" data-group="pengeluaran-global">
                    <table class="table table-bordered table-striped" style="margin-bottom: 0; min-width: 500px; white-space: nowrap;">
                        <tr>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">MADRASAH (UMUM)</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">PAUDQu</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">TPQ</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">MDT</th>
                            <th style="text-align: center; color: var(--danger); font-size: 11px; padding: 10px 4px;">TOTAL PENGELUARAN</th>
                        </tr>
                        <tr>
                            <td class="text-center val-pengeluaran-unit" id="valPengeluaranMadrasah" data-original="<%= dashboardStats.pengeluaranRekap.MADRASAH %>">Rp <%= dashboardStats.pengeluaranRekap.MADRASAH.toLocaleString('id-ID') %></td>
                            <td class="text-center val-pengeluaran-unit" id="valPengeluaranPAUDQu" data-original="<%= dashboardStats.pengeluaranRekap.PAUDQu %>">Rp <%= dashboardStats.pengeluaranRekap.PAUDQu.toLocaleString('id-ID') %></td>
                            <td class="text-center val-pengeluaran-unit" id="valPengeluaranTPQ" data-original="<%= dashboardStats.pengeluaranRekap.TPQ %>">Rp <%= dashboardStats.pengeluaranRekap.TPQ.toLocaleString('id-ID') %></td>
                            <td class="text-center val-pengeluaran-unit" id="valPengeluaranMDT" data-original="<%= dashboardStats.pengeluaranRekap.MDT %>">Rp <%= dashboardStats.pengeluaranRekap.MDT.toLocaleString('id-ID') %></td>
                            <td class="text-center font-weight-bold val-pengeluaran-total" id="valPengeluaranTotal" style="color: var(--danger); font-size: 14px;" data-original="<%= dashboardStats.pengeluaranRekap.TOTAL %>">Rp <%= dashboardStats.pengeluaranRekap.TOTAL.toLocaleString('id-ID') %></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Ziswaf JIC Subsidy -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header"><i class="fas fa-handshake mr-2"></i> STATUS SUBSIDI SPP BEASISWA (ZISWAF JIC)</div>
                <div class="table-responsive stat-group" style="overflow-x: auto;" data-group="ziswaf-subsidy">
                    <table class="table table-bordered table-striped" style="margin-bottom: 0; min-width: 500px; white-space: nowrap;">
                        <tr>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">SANTRI BARU</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">DAFTAR ULANG</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">TOTAL SANTRI</th>
                        </tr>
                        <tr>
                            <td class="text-center val-ziswaf-baru" data-original="<%= dashboardStats.ziswafStats.santriBaru %>"><%= dashboardStats.ziswafStats.santriBaru %></td>
                            <td class="text-center val-ziswaf-lama" data-original="<%= dashboardStats.ziswafStats.santriLama %>"><%= dashboardStats.ziswafStats.santriLama %></td>
                            <td class="text-center font-weight-bold val-ziswaf-total-santri" data-original="<%= dashboardStats.ziswafStats.totalSantri %>"><%= dashboardStats.ziswafStats.totalSantri %></td>
                        </tr>
                        <tr>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">TARGET DANA</th>
                            <th style="text-align: center; font-size: 11px; padding: 10px 4px;">REALISASI BAYAR</th>
                            <th style="text-align: center; color: var(--danger); font-size: 11px; padding: 10px 4px;">SISA TUNGGAKAN</th>
                        </tr>
                        <tr>
                            <td class="text-center val-ziswaf-target" data-original="<%= dashboardStats.ziswafStats.targetDana %>">Rp <%= dashboardStats.ziswafStats.targetDana.toLocaleString('id-ID') %></td>
                            <td class="text-center val-ziswaf-bayar" data-original="<%= dashboardStats.ziswafStats.realisasiBayar %>">Rp <%= dashboardStats.ziswafStats.realisasiBayar.toLocaleString('id-ID') %></td>
                            <td class="text-center font-weight-bold val-ziswaf-tunggakan" style="color: var(--danger);" data-original="<%= dashboardStats.ziswafStats.sisaTunggakan %>">Rp <%= dashboardStats.ziswafStats.sisaTunggakan.toLocaleString('id-ID') %></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <%- include('partials/chart-card', { title: 'PERSENTASE REALISASI VS TUNGGAKAN GLOBAL', chartId: 'incomeOverviewChart', iconClass: 'fas fa-chart-pie', isHalfWidth: true, isDoughnut: true }) %>
        <%- include('partials/chart-card', { title: 'PERBANDINGAN TAGIHAN & BAYAR PER UNIT', chartId: 'unitComparisonChart', iconClass: 'fas fa-chart-bar', isHalfWidth: true, isDoughnut: false }) %>
    </div>

    <!-- Main Tables -->
    <div class="row mb-4">
        <!-- Madrasah Total -->
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'INFORMASI KEUANGAN MADRASAH', groupId: 'madrasah-total', stats: dashboardStats.madrasahTotal, showSantri: true }) %>
        </div>
        <!-- Madrasah Baru -->
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'INFO KEUANGAN SANTRI BARU', groupId: 'madrasah-baru', stats: dashboardStats.madrasahBaru, showSantri: false }) %>
        </div>
        <!-- Madrasah Lama -->
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'INFO KEUANGAN DAFTAR ULANG', groupId: 'madrasah-lama', stats: dashboardStats.madrasahLama, showSantri: false }) %>
        </div>
    </div>

    <!-- Unit Baru Tables -->
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN SANTRI BARU PAUDQu', groupId: 'baru-paudqu', stats: dashboardStats.baru.PAUDQu, showSantri: true }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN SANTRI BARU TPQ', groupId: 'baru-tpq', stats: dashboardStats.baru.TPQ, showSantri: true }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN SANTRI BARU MDT', groupId: 'baru-mdt', stats: dashboardStats.baru.MDT, showSantri: true }) %>
        </div>
    </div>

    <!-- Unit Lama Tables -->
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN DAFTAR ULANG PAUDQu', groupId: 'lama-paudqu', stats: dashboardStats.lama.PAUDQu, showSantri: true }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN DAFTAR ULANG TPQ', groupId: 'lama-tpq', stats: dashboardStats.lama.TPQ, showSantri: true }) %>
        </div>
        <div class="col-md-4 mb-4">
            <%- include('partials/finance-card', { title: 'KEUANGAN DAFTAR ULANG MDT', groupId: 'lama-mdt', stats: dashboardStats.lama.MDT, showSantri: true }) %>
        </div>
    </div>

    <!-- Santri Distribution Chart Row -->
    <div class="row mb-4">
        <%- include('partials/chart-card', { title: 'DISTRIBUSI PENDAFTAR SANTRI BARU & DAFTAR ULANG PER KELAS', chartId: 'santriDistributionChart', iconClass: 'fas fa-chart-bar', isHalfWidth: false, isDoughnut: false, height: '300px' }) %>
    </div>

    <!-- New Charts Row 1 -->
    <div class="row mb-4">
        <%- include('partials/chart-card', { title: 'TREN PEMASUKAN BULANAN (TAHUN INI)', chartId: 'trendPemasukanChart', iconClass: 'fas fa-chart-line', isHalfWidth: true, isDoughnut: false }) %>
        <%- include('partials/chart-card', { title: 'RINCIAN PENGELUARAN PER KATEGORI', chartId: 'kategoriPengeluaranChart', iconClass: 'fas fa-chart-bar', isHalfWidth: true, isDoughnut: false }) %>
    </div>
    
    <!-- New Charts Row 2 -->
    <div class="row mb-4">
        <%- include('partials/chart-card', { title: 'STATUS JALUR SANTRI BARU', chartId: 'jalurBaruChart', iconClass: 'fas fa-chart-pie', isHalfWidth: true, isDoughnut: true }) %>
        <%- include('partials/chart-card', { title: 'STATUS JALUR DAFTAR ULANG', chartId: 'jalurLamaChart', iconClass: 'fas fa-chart-pie', isHalfWidth: true, isDoughnut: true }) %>
    </div>

    <div class="row mb-4">
        <!-- Rekap Baru -->
        <div class="col-md-6 mb-4">
            <%- include('partials/rekap-card', { title: 'REKAPITULASI PENDAFTAR SANTRI BARU', stats: dashboardStats.rekapBaru, totalStats: dashboardStats.madrasahBaru }) %>
        </div>

        <!-- Rekap Lama -->
        <div class="col-md-6 mb-4">
            <%- include('partials/rekap-card', { title: 'REKAPITULASI DAFTAR ULANG SANTRI LAMA', stats: dashboardStats.rekapLama, totalStats: dashboardStats.madrasahLama }) %>
        </div>
    </div>

    <!-- ================= Transaksi Terbaru ================= -->

    <div class="table-container mb-4">
        <div class="table-header">
            <div class="table-title"><i class="fas fa-list-ul mr-2"></i> Transaksi Terbaru</div>
        </div>
        <div style="overflow-x: auto;">
            <table id="transaksiTable" class="table">
                <thead>
                    <tr>
                        <th>Tanggal</th>
                        <th>No Transaksi</th>
                        <th>Nama Santri</th>
                        <th>Jenis</th>
                        <th>Nominal</th>
                        <th>Metode</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(data.transaksiTerbaru && data.transaksiTerbaru.length > 0) { %>
                        <% data.transaksiTerbaru.forEach(trx => { %>
                            <tr data-jenis="<%= trx.jenis %>" data-nominal="<%= trx.nominal %>" data-satuan="<%= trx.satuanPendidikan || 'MADRASAH' %>">
                                <td><%= trx.tanggal %></td>
                                <td><%= trx.noTransaksi %></td>
                                <td><%= trx.namaSantri %></td>
                                <td>
                                    <span class="badge <%= trx.jenis === 'Pemasukan' ? 'badge-success' : 'badge-danger' %>">
                                        <%= trx.jenis %>
                                    </span>
                                </td>
                                <td>Rp <%= trx.nominal.toLocaleString('id-ID') %></td>
                                <td>
                                    <span class="badge <%= trx.metodePembayaran === 'Transfer' ? 'badge-info' : 'badge-warning' %>" style="<%= trx.metodePembayaran === 'Transfer' ? 'background-color: #17a2b8; color: white;' : 'background-color: #ffc107; color: black;' %>">
                                        <%= trx.metodePembayaran || 'Cash' %>
                                    </span>
                                </td>
                                <td>
                                    <% if(trx.jenis === 'Pemasukan') { %>
                                        <a href="/kwitansi/<%= trx.id %>" class="btn btn-secondary" style="padding: 5px 10px; font-size: 12px;">Cetak</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center;">Belum ada transaksi</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination UI -->
        <%- include('partials/pagination', { 
            currentPage: currentPage, 
            totalPages: totalPages, 
            totalData: totalData, 
            baseUrl: '/dashboard', 
            queryParams: (typeof startDateQuery !== 'undefined' && startDateQuery ? '&startDate='+startDateQuery : '') + 
                         (typeof endDateQuery !== 'undefined' && endDateQuery ? '&endDate='+endDateQuery : '')
        }) %>
    </div>

</div> <!-- end content-area -->



<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // --- 1. Doughnut Chart: Realisasi vs Tunggakan ---
        const overallBayar = <%= dashboardStats.totalPemasukanGlobal %>;
        const overallTunggakan = <%= dashboardStats.totalTunggakan %>;

        const centerTextPlugin1 = {
            id: 'centerText1',
            beforeDraw: function(chart) {
                if (chart.data.datasets[0].data.length === 0) return;
                const ctx = chart.ctx;
                const meta = chart.getDatasetMeta(0);
                if (!meta.data || meta.data.length === 0) return;
                const centerX = meta.data[0].x;
                const centerY = meta.data[0].y;
                
                const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                const value = chart.data.datasets[0].data[0];
                const percent = total > 0 ? ((value / total) * 100).toFixed(1) + "%" : "0%";
                
                ctx.restore();
                ctx.font = "bold 22px Inter, sans-serif";
                ctx.fillStyle = "#059669"; 
                ctx.textBaseline = "middle";
                const textWidth = ctx.measureText(percent).width;
                ctx.fillText(percent, centerX - textWidth / 2, centerY - 5);
                
                ctx.font = "12px Inter, sans-serif";
                ctx.fillStyle = "#64748b";
                const label = "Tercapai";
                const labelWidth = ctx.measureText(label).width;
                ctx.fillText(label, centerX - labelWidth / 2, centerY + 15);
                ctx.save();
            }
        };

        const ctx1 = document.getElementById('incomeOverviewChart').getContext('2d');
        new Chart(ctx1, {
            type: 'doughnut',
            plugins: [centerTextPlugin1],
            data: {
                labels: ['Realisasi Bayar', 'Sisa Tunggakan'],
                datasets: [{
                    data: [overallBayar, overallTunggakan],
                    backgroundColor: ['#059669', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                cutout: '65%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: { family: 'Inter', size: 12 }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                let value = context.raw || 0;
                                return label + ': Rp ' + value.toLocaleString('id-ID');
                            }
                        }
                    }
                }
            }
        });

        // --- 2. Bar Chart: Perbandingan Unit ---
        const units = ['PAUDQu', 'TPQ', 'MDT'];
        
        // Baru
        const baruTagihan = [
            <%= dashboardStats.baru.PAUDQu.totalTagihan %>,
            <%= dashboardStats.baru.TPQ.totalTagihan %>,
            <%= dashboardStats.baru.MDT.totalTagihan %>
        ];
        const baruBayar = [
            <%= dashboardStats.baru.PAUDQu.totalBayar %>,
            <%= dashboardStats.baru.TPQ.totalBayar %>,
            <%= dashboardStats.baru.MDT.totalBayar %>
        ];

        // Lama
        const lamaTagihan = [
            <%= dashboardStats.lama.PAUDQu.totalTagihan %>,
            <%= dashboardStats.lama.TPQ.totalTagihan %>,
            <%= dashboardStats.lama.MDT.totalTagihan %>
        ];
        const lamaBayar = [
            <%= dashboardStats.lama.PAUDQu.totalBayar %>,
            <%= dashboardStats.lama.TPQ.totalBayar %>,
            <%= dashboardStats.lama.MDT.totalBayar %>
        ];

        // Combine for overall unit Tagihan vs Bayar
        const unitTagihan = units.map((_, i) => baruTagihan[i] + lamaTagihan[i]);
        const unitBayar = units.map((_, i) => baruBayar[i] + lamaBayar[i]);

        const ctx2 = document.getElementById('unitComparisonChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: units,
                datasets: [
                    {
                        label: 'Total Tagihan',
                        data: unitTagihan,
                        backgroundColor: '#cbd5e1',
                        borderRadius: 4
                    },
                    {
                        label: 'Realisasi Bayar',
                        data: unitBayar,
                        backgroundColor: '#059669',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Inter', size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                let value = context.raw || 0;
                                return label + ': Rp ' + value.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000000) return 'Rp ' + (value / 1000000000) + ' M';
                                if (value >= 1000000) return 'Rp ' + (value / 1000000) + ' Jt';
                                if (value >= 1000) return 'Rp ' + (value / 1000) + ' Rb';
                                return 'Rp ' + value;
                            }
                        }
                    }
                }
            }
        });

        // --- 3. Bar Chart: Distribusi Kelas ---
        const kelasLabels = ['PAUDQu A', 'PAUDQu B', 'TPQ A', 'TPQ B', 'TPQ C', 'MDT 1', 'MDT 2', 'MDT 3', 'MDT 4'];
        const rekapBaruData = [
            <%= dashboardStats.rekapBaru['PAUDQu A'] || 0 %>,
            <%= dashboardStats.rekapBaru['PAUDQu B'] || 0 %>,
            <%= dashboardStats.rekapBaru['TPQ A'] || 0 %>,
            <%= dashboardStats.rekapBaru['TPQ B'] || 0 %>,
            <%= dashboardStats.rekapBaru['TPQ C'] || 0 %>,
            <%= dashboardStats.rekapBaru['MDT 1'] || 0 %>,
            <%= dashboardStats.rekapBaru['MDT 2'] || 0 %>,
            <%= dashboardStats.rekapBaru['MDT 3'] || 0 %>,
            <%= dashboardStats.rekapBaru['MDT 4'] || 0 %>
        ];
        const rekapLamaData = [
            <%= dashboardStats.rekapLama['PAUDQu A'] || 0 %>,
            <%= dashboardStats.rekapLama['PAUDQu B'] || 0 %>,
            <%= dashboardStats.rekapLama['TPQ A'] || 0 %>,
            <%= dashboardStats.rekapLama['TPQ B'] || 0 %>,
            <%= dashboardStats.rekapLama['TPQ C'] || 0 %>,
            <%= dashboardStats.rekapLama['MDT 1'] || 0 %>,
            <%= dashboardStats.rekapLama['MDT 2'] || 0 %>,
            <%= dashboardStats.rekapLama['MDT 3'] || 0 %>,
            <%= dashboardStats.rekapLama['MDT 4'] || 0 %>
        ];

        const ctx3 = document.getElementById('santriDistributionChart').getContext('2d');
        new Chart(ctx3, {
            type: 'bar',
            data: {
                labels: kelasLabels,
                datasets: [
                    {
                        label: 'Santri Baru',
                        data: rekapBaruData,
                        backgroundColor: '#10b981',
                        borderRadius: 4
                    },
                    {
                        label: 'Daftar Ulang (Santri Lama)',
                        data: rekapLamaData,
                        backgroundColor: '#d97706',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Inter', size: 12 } }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        // --- 4. Line Chart: Tren Pemasukan Bulanan ---
        const trendData = <%- JSON.stringify(dashboardStats.trendArray || []) %>;
        const bulanLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
        const ctx4 = document.getElementById('trendPemasukanChart').getContext('2d');
        new Chart(ctx4, {
            type: 'line',
            data: {
                labels: bulanLabels,
                datasets: [{
                    label: 'Total Pemasukan',
                    data: trendData,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000000) return 'Rp ' + (value / 1000000000) + ' M';
                                if (value >= 1000000) return 'Rp ' + (value / 1000000) + ' Jt';
                                if (value >= 1000) return 'Rp ' + (value / 1000) + ' Rb';
                                return 'Rp ' + value;
                            }
                        }
                    }
                }
            }
        });

        // --- 5. Horizontal Bar Chart: Kategori Pengeluaran ---
        const pengeluaranKategoriData = <%- JSON.stringify(dashboardStats.pengeluaranKategori || []) %>;
        const kategoriLabels = pengeluaranKategoriData.map(item => item.kategoriDana || 'Lainnya');
        const kategoriValues = pengeluaranKategoriData.map(item => item.total);
        const ctx5 = document.getElementById('kategoriPengeluaranChart').getContext('2d');
        new Chart(ctx5, {
            type: 'bar',
            data: {
                labels: kategoriLabels,
                datasets: [{
                    label: 'Total Pengeluaran',
                    data: kategoriValues,
                    backgroundColor: '#ef4444',
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y', // Makes it horizontal
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000000) return 'Rp ' + (value / 1000000000) + ' M';
                                if (value >= 1000000) return 'Rp ' + (value / 1000000) + ' Jt';
                                if (value >= 1000) return 'Rp ' + (value / 1000) + ' Rb';
                                return 'Rp ' + value;
                            }
                        }
                    }
                }
            }
        });

        // --- 6. Pie Chart: Status Jalur Santri Baru ---
        const jalurBaruData = <%- JSON.stringify(dashboardStats.jalurStatsBaru || {}) %>;
        const ctx6 = document.getElementById('jalurBaruChart').getContext('2d');
        new Chart(ctx6, {
            type: 'pie',
            data: {
                labels: Object.keys(jalurBaruData),
                datasets: [{
                    data: Object.values(jalurBaruData),
                    backgroundColor: ['#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#64748b'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Inter', size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                let value = context.raw || 0;
                                return label + ': ' + value + ' Santri';
                            }
                        }
                    }
                }
            }
        });

        // --- 7. Pie Chart: Status Jalur Daftar Ulang ---
        const jalurLamaData = <%- JSON.stringify(dashboardStats.jalurStatsLama || {}) %>;
        const ctx7 = document.getElementById('jalurLamaChart').getContext('2d');
        new Chart(ctx7, {
            type: 'pie',
            data: {
                labels: Object.keys(jalurLamaData),
                datasets: [{
                    data: Object.values(jalurLamaData),
                    backgroundColor: ['#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#64748b'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Inter', size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                let value = context.raw || 0;
                                return label + ': ' + value + ' Santri';
                            }
                        }
                    }
                }
            }
        });
    });
</script>
<script src="/js/dashboard.js"></script>