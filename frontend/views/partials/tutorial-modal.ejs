let activeTourSteps = [];
let activeTourIndex = 0;

function detectCurrentPageTourKey() {
    const path = window.location.pathname;
    if (path.includes('/input-transaksi')) return 'input-transaksi';
    if (path.includes('/santri')) return 'santri';
    if (path.includes('/tagihan')) return 'tagihan';
    if (path.includes('/tunggakan')) return 'tunggakan';
    if (path.includes('/laporan')) return 'laporan';
    if (path.includes('/superadmin/users')) return 'superadmin-users';
    if (path.includes('/superadmin/master-data')) return 'superadmin-master';
    if (path.includes('/superadmin/logs')) return 'superadmin-logs';
    if (path.includes('/superadmin')) return 'superadmin';
    return 'dashboard';
}

function startCurrentPageTour() {
    const key = detectCurrentPageTourKey();
    launchGuidedTour(key, true);
}

function launchGuidedTour(tourKey, skipRedirect) {
    const tour = GUIDED_TOURS[tourKey];
    if (!tour) return;

    // Jika butuh pindah halaman terlebih dahulu (hanya bila dipanggil dari buku panduan, bukan dari tombol Tur Halaman di navbar)
    if (!skipRedirect && tour.url && window.location.pathname !== tour.url) {
        sessionStorage.setItem('spmb_pending_guided_tour', tourKey);
        window.location.href = tour.url;
        return;
    }

    closeAdminTutorialModal();

    // Filter hanya step yang elemennya ada di halaman saat ini
    activeTourSteps = tour.steps.filter(s => document.querySelector(s.selector));
    if (activeTourSteps.length === 0) {
        if (typeof Swal !== 'undefined') {
            Swal.fire('Info', 'Elemen yang ditunjuk tidak ditampilkan pada halaman ini.', 'info');
        }
        return;
    }

    activeTourIndex = 0;
    document.getElementById('guidedTourBackdrop').style.display = 'block';
    document.getElementById('guidedTourSpotlight').style.display = 'block';
    document.getElementById('guidedTourTooltip').style.display = 'block';
    renderGuidedTourStep();
}

function renderGuidedTourStep() {
    if (activeTourIndex < 0 || activeTourIndex >= activeTourSteps.length) {
        endGuidedTour();
        return;
    }

    const step = activeTourSteps[activeTourIndex];
    const el = document.querySelector(step.selector);
    if (!el) {
        endGuidedTour();
        return;
    }

    el.scrollIntoView({ behavior: 'smooth', block: 'center' });

    setTimeout(() => {
        const rect = el.getBoundingClientRect();
        const pad = 8;
        const spotlight = document.getElementById('guidedTourSpotlight');
        const tooltip = document.getElementById('guidedTourTooltip');

        spotlight.style.top = Math.max(4, rect.top - pad) + 'px';
        spotlight.style.left = Math.max(4, rect.left - pad) + 'px';
        spotlight.style.width = Math.min(window.innerWidth - 8, rect.width + pad * 2) + 'px';
        spotlight.style.height = (rect.height + pad * 2) + 'px';

        document.getElementById('gtourStepBadge').innerText = `Penunjuk Visual ${activeTourIndex + 1} dari ${activeTourSteps.length}`;
        document.getElementById('gtourTitle').innerText = step.title;
        document.getElementById('gtourDesc').innerText = step.desc;

        const btnPrev = document.getElementById('gtourBtnPrev');
        const btnNext = document.getElementById('gtourBtnNext');
        btnPrev.style.display = activeTourIndex === 0 ? 'none' : 'inline-block';
        btnNext.innerHTML = activeTourIndex === activeTourSteps.length - 1 ? '<i class="fas fa-check"></i> Selesai' : 'Lanjut &rarr;';

        // Posisikan tooltip di bawah atau di atas elemen
        const tooltipWidth = 360;
        let topPos = rect.bottom + pad + 14;
        if (topPos + 210 > window.innerHeight) {
            topPos = Math.max(12, rect.top - 210);
        }
        let leftPos = rect.left;
        if (leftPos + tooltipWidth > window.innerWidth - 16) {
            leftPos = Math.max(12, window.innerWidth - tooltipWidth - 16);
        }

        tooltip.style.top = topPos + 'px';
        tooltip.style.left = leftPos + 'px';
    }, 280);
}

function stepGuidedTour(dir) {
    activeTourIndex += dir;
    if (activeTourIndex >= activeTourSteps.length) {
        endGuidedTour();
        return;
    }
    renderGuidedTourStep();
}

function endGuidedTour() {
    document.getElementById('guidedTourBackdrop').style.display = 'none';
    document.getElementById('guidedTourSpotlight').style.display = 'none';
    document.getElementById('guidedTourTooltip').style.display = 'none';
    activeTourSteps = [];
}

// Jalankan tur otomatis jika baru saja berpindah halaman dari tombol "Tunjukkan di Layar"
document.addEventListener('DOMContentLoaded', function() {
    const pendingTour = sessionStorage.getItem('spmb_pending_guided_tour');
    if (pendingTour) {
        sessionStorage.removeItem('spmb_pending_guided_tour');
        setTimeout(() => {
            launchGuidedTour(pendingTour);
        }, 450);
    }
});

window.addEventListener('resize', function() {
    if (activeTourSteps.length > 0) {
        renderGuidedTourStep();
    }
});

function openAdminTutorialModal(initialTabId) {
    endGuidedTour();
    const modal = document.getElementById('adminTutorialModal');
    if (!modal) return;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    const searchInput = document.getElementById('tutorialSearchInput');
    if (searchInput && searchInput.value) {
        searchInput.value = '';
        filterTutorialSearch('');
    }

    if (initialTabId) {
        const targetBtn = document.querySelector(`.tutorial-nav-btn[data-target="${initialTabId}"]`);
        if (targetBtn) switchTutorialTab(initialTabId, targetBtn);
    } else {
        // Otomatis buka bab yang sesuai dengan halaman yang sedang dibuka jika baru pertama dibuka
        updateTutorialNavButtons();
    }
}

function closeAdminTutorialModal() {
    const modal = document.getElementById('adminTutorialModal');
    if (!modal) return;
    modal.style.display = 'none';
    document.body.style.overflow = '';
}

function switchTutorialTab(targetId, btnElement) {
    const searchInput = document.getElementById('tutorialSearchInput');
    if (searchInput && searchInput.value.trim() !== '') {
        searchInput.value = '';
        document.getElementById('tutorialNoResult').style.display = 'none';
    }

    currentTutorialId = targetId;
    document.querySelectorAll('.tutorial-section').forEach(sec => {
        sec.classList.remove('active');
        sec.style.display = '';
    });
    document.querySelectorAll('.tutorial-nav-btn').forEach(btn => {
        btn.classList.remove('active');
    });

    const targetSec = document.getElementById(targetId);
    if (targetSec) targetSec.classList.add('active');
    if (btnElement) {
        btnElement.classList.add('active');
    } else {
        const autoBtn = document.querySelector(`.tutorial-nav-btn[data-target="${targetId}"]`);
        if (autoBtn) autoBtn.classList.add('active');
    }

    const contentArea = document.getElementById('tutorialContentArea');
    if (contentArea) contentArea.scrollTop = 0;

    updateTutorialNavButtons();
}

function navigateTutorialStep(direction) {
    const idx = tutorialOrder.indexOf(currentTutorialId);
    if (idx === -1) return;
    const nextIdx = idx + direction;
    if (nextIdx >= 0 && nextIdx < tutorialOrder.length) {
        switchTutorialTab(tutorialOrder[nextIdx]);
    }
}

functionUpdateNavSafe();
function functionUpdateNavSafe() {
    document.addEventListener('DOMContentLoaded', updateTutorialNavButtons);
}

function updateTutorialNavButtons() {
    const idx = tutorialOrder.indexOf(currentTutorialId);
    const btnPrev = document.getElementById('btnPrevTutorial');
    const btnNext = document.getElementById('btnNextTutorial');
    if (btnPrev) btnPrev.disabled = (idx <= 0);
    if (btnNext) btnNext.disabled = (idx >= tutorialOrder.length - 1);
}

function filterTutorialSearch(query) {
    const q = (query || '').trim().toLowerCase();
    const sections = document.querySelectorAll('.tutorial-section');
    const noResult = document.getElementById('tutorialNoResult');

    if (!q) {
        noResult.style.display = 'none';
        sections.forEach(sec => {
            sec.style.display = '';
            sec.classList.toggle('active', sec.id === currentTutorialId);
        });
        return;
    }

    let matchCount = 0;
    sections.forEach(sec => {
        const text = sec.innerText.toLowerCase();
        if (text.includes(q)) {
            sec.style.display = 'block';
            sec.classList.add('active');
            matchCount++;
        } else {
            sec.style.display = 'none';
            sec.classList.remove('active');
        }
    });

    noResult.style.display = matchCount === 0 ? 'block' : 'none';
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const modal = document.getElementById('adminTutorialModal');
        if (modal && modal.style.display === 'flex') {
            closeAdminTutorialModal();
        }
        if (activeTourSteps.length > 0) {
            endGuidedTour();
        }
    }
});

document.addEventListener('click', function(e) {
    const modal = document.getElementById('adminTutorialModal');
    if (modal && e.target === modal) {
        closeAdminTutorialModal();
    }
});
