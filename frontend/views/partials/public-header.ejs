<%
/**
 * Reusable Component: public-header.ejs
 * Props:
 * - activeView: string ('pendaftaran' | 'pendaftaran-ulang' | 'beasiswa' | 'info-pembayaran' | ...)
 * - tahunAjaran: string (e.g. '2026/2027')
 */
const currentView = typeof activeView !== 'undefined' ? activeView : '';
const taLabel = typeof tahunAjaran !== 'undefined' && tahunAjaran ? tahunAjaran : '2026/2027';

const navTabs = [
    { href: '/', view: 'landing', icon: 'fas fa-home', label: 'Beranda', activeClass: '' },
    { href: '/daftar', view: 'pendaftaran', icon: 'fas fa-user-plus', label: 'Santri Baru', activeClass: 'tab-emerald' },
    { href: '/daftar-ulang', view: 'pendaftaran-ulang', icon: 'fas fa-sync-alt', label: 'Daftar Ulang', activeClass: 'tab-indigo' },
    { href: '/daftar/beasiswa', view: 'beasiswa', icon: 'fas fa-hand-holding-heart', label: 'Beasiswa', activeClass: 'tab-amber' },
    { href: '/info-pembayaran', view: 'info-pembayaran', icon: 'fas fa-wallet', label: 'Cek Tagihan', activeClass: 'tab-teal' }
];
%>
<div class="public-header">
    <div class="public-header-inner">
        <a href="/" class="public-header-brand" data-pjax>
            <img src="/images/Logo%20Madrasah.webp" alt="Logo Madrasah JIC" class="public-header-logo">
            <div class="public-header-titles">
                <h1>Madrasah Jakarta Islamic Centre</h1>
                <p>Sistem Penerimaan Murid Baru Tahun Ajaran <%= taLabel %></p>
            </div>
        </a>

        <!-- Quick Switcher Pill Tabs between Public Forms -->
        <nav class="public-mode-tabs" aria-label="Navigasi Cepat Formulir">
            <% navTabs.forEach(tab => { %>
                <a href="<%= tab.href %>" class="public-mode-tab <%= currentView === tab.view ? ('active ' + tab.activeClass) : '' %>" data-pjax>
                    <i class="<%= tab.icon %>"></i> <span><%= tab.label %></span>
                </a>
            <% }) %>
        </nav>
    </div>
</div>
