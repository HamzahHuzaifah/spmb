<% 
const lay = typeof layout !== 'undefined' ? layout : 'stacked';
const idPre = typeof idPrefix !== 'undefined' ? idPrefix : '';
const cGroup = typeof groupClass !== 'undefined' ? groupClass : (lay === 'flat-grid' || lay === 'grid-rows' ? 'form-group-modal' : 'form-group');
const nInput = typeof nameInputName !== 'undefined' ? nameInputName : 'namaSantri';
const gInputType = typeof genderInputType !== 'undefined' ? genderInputType : 'radio';
const gInputName = typeof genderInputName !== 'undefined' ? genderInputName : 'jenisKelamin';
const isRead = typeof isReadonly !== 'undefined' ? isReadonly : false;
const isSelectName = typeof useNameSelect !== 'undefined' ? useNameSelect : false;

const form = typeof formData !== 'undefined' && formData ? formData : {};
const getVal = (field, fallback = '') => (form[field] !== undefined ? form[field] : fallback);
%>

<% if (lay === 'stacked') { %>
    <div class="<%= cGroup %>">
        <label class="required">Nama Lengkap Santri</label>
        <% if (isSelectName) { %>
            <select name="<%= nInput %>" id="<%= idPre %>nama" class="form-input kandidat-nama-select" data-selected="<%= getVal(nInput) %>" required>
                <option value="">-- Pilih Kelas Sebelumnya Terlebih Dahulu atau Ketik Nama --</option>
                <% if (getVal(nInput)) { %>
                    <option value="<%= getVal(nInput) %>" selected><%= getVal(nInput) %></option>
                <% } %>
            </select>
            <div id="<%= idPre %>nama_help" class="form-help" style="margin-top: 6px; color: #059669; font-size: 12.5px;">
                <i class="fas fa-info-circle"></i> Pilih <strong>Unit / Satuan Pendidikan Sebelumnya</strong> di atas untuk memunculkan daftar nama santri tahun ajaran sebelumnya, atau ketik manual jika nama belum tercantum.
            </div>
        <% } else { %>
            <input type="text" name="<%= nInput %>" id="<%= idPre %>nama" class="form-input" placeholder="Masukkan nama lengkap" value="<%= getVal(nInput) %>" required>
        <% } %>
    </div>

    <div class="<%= cGroup %>">
        <label>Nama Panggilan</label>
        <input type="text" name="namaPanggilan" id="<%= idPre %>namaPanggilan" class="form-input" placeholder="Masukkan nama panggilan" value="<%= getVal('namaPanggilan') %>">
    </div>

    <div class="<%= cGroup %>">
        <label class="required">Jenis Kelamin</label>
        <% if (gInputType === 'radio') { %>
            <div class="radio-group radio-group-inline">
                <label class="radio-label radio-pill-choice">
                    <input type="radio" name="<%= gInputName %>" value="Laki-laki" <%= getVal(gInputName) === 'Laki-laki' || !getVal(gInputName) ? 'checked' : '' %> required>
                    <span>Laki-laki</span>
                </label>
                <label class="radio-label radio-pill-choice">
                    <input type="radio" name="<%= gInputName %>" value="Perempuan" <%= getVal(gInputName) === 'Perempuan' ? 'checked' : '' %>>
                    <span>Perempuan</span>
                </label>
            </div>
        <% } else { %>
            <select name="<%= gInputName %>" id="<%= idPre %>jenisKelamin" class="form-input" required>
                <option value="Laki-laki" <%= getVal(gInputName) === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
                <option value="Perempuan" <%= getVal(gInputName) === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
            </select>
        <% } %>
    </div>

    <div class="<%= cGroup %> ttl-split-group">
        <div class="ttl-split-col">
            <label class="required">Tempat Lahir</label>
            <input type="text" name="tempatLahir" id="<%= idPre %>tempatLahir" class="form-input" placeholder="Kota tempat lahir" value="<%= getVal('tempatLahir') %>" required>
        </div>
        <div class="ttl-split-col">
            <label class="required">Tanggal Lahir</label>
            <input type="date" name="tanggalLahir" id="<%= idPre %>tanggalLahir" class="form-input" value="<%= getVal('tanggalLahir') %>" required>
        </div>
    </div>

    <div class="<%= cGroup %>">
        <label class="required">Agama</label>
        <% if (isRead) { %>
            <input type="text" name="agama" id="<%= idPre %>agama" class="form-input" value="<%= getVal('agama', 'Islam') %>" readonly>
        <% } else { %>
            <%- include('select-agama', { 
                name: 'agama',
                id: idPre + 'agama',
                className: 'form-input',
                required: true,
                selectedValue: getVal('agama', 'Islam')
            }) %>
        <% } %>
    </div>

    <div class="<%= cGroup %>">
        <label class="required">Status dalam Keluarga</label>
        <%- include('select-status-keluarga', { 
            name: 'statusKeluarga',
            id: idPre + 'statusKeluarga',
            className: 'form-input',
            required: true,
            selectedValue: getVal('statusKeluarga')
        }) %>
    </div>

    <div class="<%= cGroup %>">
        <label class="required">Anak ke (berdasarkan Kartu Keluarga)</label>
        <div class="sibling-inline-row">
            <span class="sibling-label">Anak ke</span>
            <input type="number" name="anakKe" id="<%= idPre %>anakKe" class="form-input sibling-number-input" min="1" inputmode="numeric" placeholder="1" value="<%= getVal('anakKe') %>" required>
            <span class="sibling-label">dari</span>
            <input type="number" name="dariBersaudara" id="<%= idPre %>dariBersaudara" class="form-input sibling-number-input" min="1" inputmode="numeric" placeholder="2" value="<%= getVal('dariBersaudara') %>" required>
            <span class="sibling-label">Bersaudara</span>
        </div>
    </div>

    <div class="<%= cGroup %>">
        <label>Asal Sekolah</label>
        <input type="text" name="asalSekolah" id="<%= idPre %>asalSekolah" class="form-input"
            placeholder="Nama asal sekolah (contoh: BimBa / TK ...). Kosongkan jika belum pernah." value="<%= getVal('asalSekolah') %>">
    </div>

<% } else if (lay === 'flat-grid' || lay === 'grid-rows' || lay === 'flex-rows') { %>
    <% if (lay === 'grid-rows') { %><div class="modal-grid"><% } else if (lay === 'flex-rows') { %><div class="<%= cGroup %>" style="display: flex; gap: 20px; margin-bottom: 15px;"><% } %>
    
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Nama Lengkap Santri</label>
            <% if (isSelectName) { %>
                <select name="<%= nInput %>" id="<%= idPre %>nama" class="form-input kandidat-nama-select" required>
                    <option value="">-- Pilih Kelas Sebelumnya atau Ketik Nama --</option>
                </select>
                <div id="<%= idPre %>nama_help" class="form-help" style="margin-top: 4px; color: #059669; font-size: 11.5px;">
                    Pilih Unit Sebelumnya untuk menampilkan daftar nama, atau ketik manual.
                </div>
            <% } else { %>
                <input type="text" name="<%= nInput %>" id="<%= idPre %>nama" class="form-input" required>
            <% } %>
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label>Nama Panggilan</label>
            <input type="text" name="namaPanggilan" id="<%= idPre %>namaPanggilan" class="form-input">
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Jenis Kelamin</label>
            <% if (gInputType === 'radio') { %>
                <div class="radio-group" style="margin-top: 5px;">
                    <label class="radio-label">
                        <input type="radio" name="<%= gInputName %>" value="Laki-laki" required> Laki-laki
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="<%= gInputName %>" value="Perempuan"> Perempuan
                    </label>
                </div>
            <% } else { %>
                <select name="<%= gInputName %>" id="<%= idPre %>jenisKelamin" class="form-input" required>
                    <option value="Laki-laki">Laki-laki</option>
                    <option value="Perempuan">Perempuan</option>
                </select>
            <% } %>
        </div>

    <% if (lay === 'grid-rows' || lay === 'flex-rows') { %></div><% } %>
    <% if (lay === 'grid-rows') { %><div class="modal-grid"><% } else if (lay === 'flex-rows') { %><div class="<%= cGroup %>" style="display: flex; gap: 20px; margin-bottom: 15px;"><% } %>

        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Tempat Lahir</label>
            <input type="text" name="tempatLahir" id="<%= idPre %>tempatLahir" class="form-input" required>
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Tanggal Lahir</label>
            <input type="date" name="tanggalLahir" id="<%= idPre %>tanggalLahir" class="form-input" required>
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Agama</label>
            <% if (isRead) { %>
                <input type="text" name="agama" id="<%= idPre %>agama" class="form-input" value="Islam" readonly>
            <% } else { %>
                <%- include('select-agama', { 
                    name: 'agama',
                    id: idPre + 'agama',
                    className: 'form-input',
                    required: true,
                    selectedValue: 'Islam'
                }) %>
            <% } %>
        </div>

    <% if (lay === 'grid-rows' || lay === 'flex-rows') { %></div><% } %>
    <% if (lay === 'grid-rows') { %><div class="modal-grid"><% } else if (lay === 'flex-rows') { %><div class="<%= cGroup %>" style="display: flex; gap: 20px; margin-bottom: 15px;"><% } %>

        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Status Keluarga</label>
            <%- include('select-status-keluarga', { 
                name: 'statusKeluarga',
                id: idPre + 'statusKeluarga',
                className: 'form-input',
                required: true,
                placeholder: ''
            }) %>
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label class="required">Anak ke (dari Bersaudara)</label>
            <div style="display: flex; gap: 10px; align-items: center;">
                <input type="number" name="anakKe" id="<%= idPre %>anakKe" class="form-input" required>
                <span>dari</span>
                <input type="number" name="dariBersaudara" id="<%= idPre %>dariBersaudara" class="form-input" required>
            </div>
        </div>
        
        <% if (lay === 'flex-rows') { %><div style="flex: 1;"><% } else { %><div class="<%= cGroup %>"><% } %>
            <label>Asal Sekolah</label>
            <input type="text" name="asalSekolah" id="<%= idPre %>asalSekolah" class="form-input">
        </div>

    <% if (lay === 'grid-rows' || lay === 'flex-rows') { %></div><% } %>

<% } %>
