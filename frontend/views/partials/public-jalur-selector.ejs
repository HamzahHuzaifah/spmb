<%
/**
 * Reusable Component: public-jalur-selector.ejs
 * Props:
 * - mode: 'reguler' | 'ulang' | 'beasiswa'
 * - inputName: string (default: 'jalurPendaftaran' or 'jalurBeasiswa')
 * - jalurList: Array<{ nama, syarat_dokumen }>
 */
const selectorMode = typeof mode !== 'undefined' ? mode : 'reguler';
const fieldName = typeof inputName !== 'undefined' ? inputName : (selectorMode === 'beasiswa' ? 'jalurBeasiswa' : 'jalurPendaftaran');
const list = (typeof jalurList !== 'undefined' && Array.isArray(jalurList)) ? jalurList : [];
%>

<% if (selectorMode === 'reguler') { %>
    <div class="form-group" style="margin-bottom: 25px;">
        <label class="required">Jalur Pendaftaran</label>
        <div class="radio-group radio-card-stack">
            <% if (list.length > 0) {
                let hasReguler = false;
                list.forEach((jalur, index) => {
                    if (!jalur.nama.toLowerCase().includes('beasiswa')) {
                        hasReguler = true;
            %>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="<%= jalur.nama %>" <%= index === 0 ? 'required checked' : '' %>>
                <div class="radio-card-body">
                    <strong><%= jalur.nama %></strong>
                    <% if (jalur.syarat_dokumen) { %>
                        <div class="form-help"><%= jalur.syarat_dokumen %></div>
                    <% } %>
                </div>
            </label>
            <%      }
                });
                if (!hasReguler) { %>
                    <div style="color: #b91c1c; font-size: 14px;">Belum ada jalur pendaftaran reguler yang aktif.</div>
            <%  }
            } else { %>
                <label class="radio-label radio-card-option">
                    <input type="radio" name="<%= fieldName %>" value="Reguler" required checked>
                    <div class="radio-card-body">
                        <strong>Reguler</strong>
                    </div>
                </label>
            <% } %>
        </div>
    </div>

<% } else if (selectorMode === 'ulang') { %>
    <div class="form-group">
        <label class="required">Jalur Pendaftaran Daftar Ulang</label>
        <div class="radio-group radio-card-stack">
            <% if (list.length > 0) {
                list.forEach((jalur, index) => {
            %>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="<%= jalur.nama %>" <%= index === 0 ? 'required checked' : '' %>>
                <div class="radio-card-body">
                    <strong><%= jalur.nama %></strong>
                    <% if (jalur.syarat_dokumen) { %>
                        <div class="form-help" style="margin-top: 5px;"><%= jalur.syarat_dokumen %></div>
                    <% } %>
                </div>
            </label>
            <%  });
            } else { %>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Reguler" required checked>
                <div class="radio-card-body"><strong>Reguler</strong></div>
            </label>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Dhuafa">
                <div class="radio-card-body"><strong>Beasiswa Dhuafa</strong></div>
            </label>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Yatim/Piatu">
                <div class="radio-card-body"><strong>Beasiswa Yatim/Piatu</strong></div>
            </label>
            <% } %>
        </div>
    </div>

<% } else if (selectorMode === 'beasiswa') { %>
    <div class="form-group" style="margin-bottom: 30px;">
        <div class="radio-group radio-card-stack">
            <% if (list.length > 0) {
                let hasBeasiswa = false;
                list.forEach((jalur) => {
                    if (jalur.nama.toLowerCase().includes('beasiswa')) {
                        hasBeasiswa = true;
            %>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="<%= jalur.nama %>" required>
                <div class="radio-card-body">
                    <strong><%= jalur.nama %></strong>
                    <% if (jalur.syarat_dokumen) { %>
                        <div class="form-help"><%= jalur.syarat_dokumen %></div>
                    <% } %>
                </div>
            </label>
            <%      }
                });
                if (!hasBeasiswa) { %>
                    <div style="color: #b91c1c; font-size: 14px;">Belum ada jalur pendaftaran beasiswa yang aktif.</div>
            <%  }
            } else { %>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Dhuafa" required>
                <div class="radio-card-body">
                    <strong>Beasiswa Dhuafa</strong>
                    <div class="form-help">Potongan biaya khusus bagi kaum dhuafa (wajib melampirkan SKTM).</div>
                </div>
            </label>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Yatim/Piatu">
                <div class="radio-card-body">
                    <strong>Beasiswa Yatim/Piatu</strong>
                    <div class="form-help">Potongan biaya khusus anak yatim/piatu (wajib melampirkan Surat Keterangan/Akta Kematian dan SKTM).</div>
                </div>
            </label>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Pekerja/Komunitas di JIC">
                <div class="radio-card-body">
                    <strong>Beasiswa Pekerja/Komunitas di JIC</strong>
                    <div class="form-help">Potongan biaya khusus bagi Keluarga Pegawai/PJLP/Komunitas JIC (wajib melampirkan KTP &amp; KK orang tua serta Kartu Pegawai/PJLP/Komunitas JIC atau surat keterangan dari kantor atau komunitas)</div>
                </div>
            </label>
            <label class="radio-label radio-card-option">
                <input type="radio" name="<%= fieldName %>" value="Beasiswa Satu Keluarga">
                <div class="radio-card-body">
                    <strong>Beasiswa Satu Keluarga</strong>
                    <div class="form-help">Potongan biaya khusus jika mendaftarkan atau menyekolahkan 2 anak kandung atau lebih dalam satu keluarga. (wajib melampirkan KTP &amp; KK orang tua)</div>
                </div>
            </label>
            <% } %>
        </div>
    </div>
<% } %>
